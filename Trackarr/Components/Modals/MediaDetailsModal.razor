@using Trackarr.Core.Media.Movies
@using Trackarr.Core.Queue
@using Trackarr.Services.Media
@inject IJSRuntime Js
@inject MediaServerService MediaServerService

<div id = "mediaDetailsModal" class = "modal modal-blur fade" tabindex = "-1">
    <div class = "modal-dialog modal-xl modal-dialog-centered" role = "document">
        <div class = "modal-content media-modal">

            <div class = "modal-content">
                @* ── Header ── *@
                <div class = "modal-header align-items-start border-bottom border-secondary-subtle p-4">
                    <div class = "d-flex gap-4 w-100 min-w-0">
                        <div class = "flex-shrink-0">
                            <img class = "rounded object-fit-cover shadow-sm"
                                 width = "112"
                                 height = "164"
                                 src = "@_media?.PosterUrl"
                                 alt = "@_media?.Title" />
                        </div>

                        <div class = "flex-fill min-w-0">
                            <div class = "d-flex align-items-center gap-2">
                                <h1 class = "modal-title mb-0 text-truncate">@TitleDisplay</h1>
                                <span class = "badge bg-secondary-lt text-secondary">@TypeLabel</span>
                            </div>

                            <div class = "text-secondary fs-3 mt-1 text-truncate">@HeaderSubtitle</div>

                            <div class = "row g-0 mt-4">
                                <div class = "col-6 col-md-4 col-xl pe-4 border-end border-secondary-subtle overflow-hidden">
                                    <div class = "small fw-bold text-uppercase text-secondary mb-2 text-truncate">
                                        Status
                                    </div>
                                    <span class = "@StatusBadgeClass(StatusText) text-truncate d-inline-block mw-100"
                                          title = "@StatusText">
                                        @StatusText
                                    </span>
                                </div>

                                <div class = "col-6 col-md-4 col-xl px-4 border-end border-secondary-subtle overflow-hidden">
                                    <div class = "small fw-bold text-uppercase text-secondary mb-2 text-truncate">
                                        Server
                                    </div>
                                    <span class = "@ServerBadgeClass(_server?.ServiceType, _server?.Name) text-truncate d-inline-block mw-100"
                                          title = "@ServerDisplay">
                                        @ServerDisplay
                                    </span>
                                </div>

                                <div class = "col-6 col-md-4 col-xl px-4 border-end border-secondary-subtle overflow-hidden">
                                    <div class = "small fw-bold text-uppercase text-secondary mb-2 text-truncate">
                                        Profile
                                    </div>
                                    <span class = "badge bg-secondary-lt text-secondary text-truncate d-inline-block mw-100"
                                          title = "@ProfileDisplay">
                                        @ProfileDisplay
                                    </span>
                                </div>

                                <div class = "col-6 col-md-4 col-xl px-4 border-end border-secondary-subtle overflow-hidden">
                                    <div class = "small fw-bold text-uppercase text-secondary mb-2 text-truncate">
                                        Added
                                    </div>
                                    <div class = "fw-semibold text-truncate" title = "@TimeAgo(Item?.Added)">
                                        @TimeAgo(Item?.Added)
                                    </div>
                                </div>

                                <div class = "col-6 col-md-4 col-xl px-4 border-end border-secondary-subtle overflow-hidden">
                                    <div class = "small fw-bold text-uppercase text-secondary mb-2 text-truncate">Last
                                                                                                                  Activity
                                    </div>
                                    <div class = "fw-semibold text-truncate" title = "@LastActivityDisplay">
                                        @LastActivityDisplay
                                    </div>
                                </div>

                                <div class = "col-6 col-md-4 col-xl ps-4 overflow-hidden">
                                    <div class = "small fw-bold text-uppercase text-secondary mb-2 text-truncate">
                                        Strikes
                                    </div>
                                    <div class = "d-flex align-items-center gap-2 mt-1">

                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type = "button"
                                class = "btn-close ms-3"
                                data-bs-dismiss = "modal"
                                aria-label = "Close"></button>
                    </div>
                </div>


                @* ── Tab bar ── *@
                <div class = "modal-tabs px-5 d-flex align-items-center justify-content-between border-bottom border-secondary-subtle">
                    <ul class = "nav nav-underline tab-contorl">
                        <li class = "nav-item">
                            <a class = "nav-link py-3 @(_activeTab == "overview" ? "active" : "")"
                               @onclick = '() => _activeTab = "overview"'><i class = "bi bi-grid me-1"></i>Overview
                            </a>
                        </li>
                        <li class = "nav-item">
                            <a class = "nav-link py-3 @(_activeTab == "history" ? "active" : "")"
                               @onclick = '() => _activeTab = "history"'><i class = "bi bi-clock-history me-1"></i>History
                            </a>
                        </li>
                        <li class = "nav-item">
                            <a class = "nav-link py-3 @(_activeTab == "attempts" ? "active" : "")"
                               @onclick = '() => _activeTab = "attempts"'><i class = "bi bi-arrow-repeat me-1"></i>Attempts
                            </a>
                        </li>
                        <li class = "nav-item">
                            <a class = "nav-link py-3 @(_activeTab == "files" ? "active" : "")"
                               @onclick = '() => _activeTab = "files"'><i class = "bi bi-file-earmark me-1"></i>Files
                            </a>
                        </li>
                        <li class = "nav-item">
                            <a class = "nav-link py-3 @(_activeTab == "logs" ? "active" : "")"
                               @onclick = '() => _activeTab = "logs"'><i class = "bi bi-terminal me-1"></i>Logs
                            </a>
                        </li>
                    </ul>
                    <div class = "dropdown">
                        <button class = "btn btn-app-ghost btn-secondary dropdown-toggle" data-bs-toggle = "dropdown">
                            Actions
                        </button>
                        <ul class = "dropdown-menu dropdown-menu-end">
                            <li>
                                <a class = "dropdown-item">Force Search</a>
                            </li>
                            <li>
                                <a class = "dropdown-item">Blacklist</a>
                            </li>
                        </ul>
                    </div>
                </div>

                @* ── Body ── *@
                <div class = "modal-body p-3">
                    @if (_activeTab == "overview") {
                        <div class = "row g-3">

                            @* Episode / Movie Details *@
                            <div class = "col-5">
                                @if (IsSeries) {
                                    <div class = "d-flex flex-column gap-3">
                                        <div class = "card">
                                            <div class = "card-header h3 fw-bold">
                                                Episode Details
                                            </div>

                                            @if (_episode != null) {
                                                <DetailRow Label = "Absolute"
                                                           Value = "@_episode.AbsoluteEpisodeNumber.ToString()" />
                                                <DetailRow Label = "Air Date"
                                                           Value = "@DateTimeDisplay(_episode.AirDateUtc)" />
                                                <DetailRow Label = "Has File" Value = "@YesNo(_episode.HasFile)" />
                                            }
                                            else {
                                                <DetailRow Label = "Episode" Value = "—" />
                                            }
                                        </div>

                                        <div class = "card">
                                            <div class = "card-header h3 fw-bold">
                                                Series Details
                                            </div>

                                            @if (_series != null) {
                                                <DetailRow Label = "Ended" Value = "@YesNo(_series.Ended)" />
                                                <DetailRow Label = "Network" Value = "@TextDisplay(_series.Network)" />
                                                <DetailRow Label = "Air Time" Value = "@TextDisplay(_series.AirTime)" />
                                                <DetailRow Label = "Language Profile ID"
                                                           Value = "@NullableIntDisplay(_series.LanguageProfileId)" />
                                                <DetailRow Label = "Season Folder"
                                                           Value = "@YesNo(_series.SeasonFolder)" />
                                                <DetailRow Label = "Monitor New Items"
                                                           Value = "@TextDisplay(_series.MonitorNewItems)" />
                                                <DetailRow Label = "Use Scene Numbering"
                                                           Value = "@YesNo(_series.UseSceneNumbering)" />
                                                <DetailRow Label = "TVDB ID" Value = "@_series.TvdbId.ToString()" />
                                                <DetailRow Label = "TVRage ID" Value = "@_series.TvRageId.ToString()" />
                                                <DetailRow Label = "TVMaze ID" Value = "@_series.TvMazeId.ToString()" />
                                                <DetailRow Label = "Root Folder Path"
                                                           Value = "@TextDisplay(_series.RootFolderPath)" />
                                                <DetailRow Label = "Series Type"
                                                           Value = "@TextDisplay(_series.SeriesType)" />
                                                <DetailRow Label = "First Aired"
                                                           Value = "@DateDisplay(_series.FirstAired)" />
                                                <DetailRow Label = "Last Aired"
                                                           Value = "@DateDisplay(_series.LastAired)" />
                                                <DetailRow Label = "Next Airing"
                                                           Value = "@DateTimeDisplay(_series.NextAiring)" />
                                                <DetailRow Label = "Previous Airing"
                                                           Value = "@DateTimeDisplay(_series.PreviousAiring)" />
                                            }
                                            else {
                                                <DetailRow Label = "Series" Value = "—" />
                                            }
                                        </div>
                                    </div>
                                }
                                else if (_media is Movie movie) {
                                    <div class = "card">
                                        <div class = "card-header h3 fw-bold">
                                            Movie Details
                                        </div>

                                        <DetailRow Label = "Original Title"
                                                   Value = "@TextDisplay(movie.OriginalTitle)" />
                                        <DetailRow Label = "Website"
                                                   Value = "@TextDisplay(movie.Website)"
                                                   LinkUrl = "@movie.Website"
                                                   LinkText = "@movie.Website" />
                                        <DetailRow Label = "YouTube Trailer"
                                                   Value = "@movie.YouTubeTrailerId"
                                                   LinkText = "Watch Trailer"
                                                   LinkUrl = "@YouTubeTrailerUrl(movie.YouTubeTrailerId)" />
                                        <DetailRow Label = "Studio" Value = "@TextDisplay(movie.Studio)" />
                                        <DetailRow Label = "Has File" Value = "@YesNo(movie.HasFile)" />
                                        <DetailRow Label = "Movie File ID" Value = "@movie.MovieFileId.ToString()" />
                                        <DetailRow Label = "Minimum Availability"
                                                   Value = "@TextDisplay(movie.MinimumAvailability)" />
                                        <DetailRow Label = "Available" Value = "@YesNo(movie.IsAvailable)" />
                                        <DetailRow Label = "Folder Name" Value = "@TextDisplay(movie.FolderName)" />
                                        <DetailRow Label = "Size On Disk" Value = "@FormatBytes(movie.SizeOnDisk)" />
                                        <DetailRow Label = "In Cinemas" Value = "@DateDisplay(movie.InCinemas)" />
                                        <DetailRow Label = "Physical Release"
                                                   Value = "@DateDisplay(movie.PhysicalRelease)" />
                                        <DetailRow Label = "Digital Release"
                                                   Value = "@DateDisplay(movie.DigitalRelease)" />
                                        <DetailRow Label = "Release Date" Value = "@DateDisplay(movie.ReleaseDate)" />
                                        <DetailRow Label = "Last Search Time"
                                                   Value = "@DateTimeDisplay(movie.LastSearchTime)" />
                                        <DetailRow Label = "Popularity" Value = "@movie.Popularity.ToString("0.##")" />
                                    </div>
                                }
                            </div>

                            @* Download Details *@
                            <div class = "col-7">
                                <div class = "d-flex flex-column gap-3">
                                    <div class = "card">
                                        <div class = "card-header h3 fw-bold">
                                            Download Details
                                        </div>

                                        <DetailRow Label = "Release" Value = "@TextDisplay(Item?.Title)" />
                                        <DetailRow Label = "Indexer" Value = "@TextDisplay(Item?.Indexer)" />
                                        <DetailRow Label = "Protocol"
                                                   IsBadge = "true"
                                                   Value = "@TextDisplay(Item?.Protocol)"
                                                   BadgeClass = "app-badge-muted" />
                                        <DetailRow Label = "Download Client"
                                                   IsBadge = "true"
                                                   Value = "@TextDisplay(Item?.DownloadClient)"
                                                   BadgeClass = "app-badge-muted" />
                                        <DetailRow Label = "Post Import Category"
                                                   Value = "@YesNo(Item?.DownloadClientHasPostImportCategory == true)" />
                                        <DetailRow Label = "Output Path"
                                                   Value = "@TextDisplay(Item?.OutputPath)"
                                                   Mono = "true" />
                                    </div>

                                    <div class = "card">
                                        <div class = "card-header h3 fw-bold">
                                            Progress
                                        </div>

                                        <DetailRow Label = "Size" Value = "@SizeDisplay" />
                                        <DetailRow Label = "Downloaded" Value = "@DownloadedDisplay" />
                                        <DetailRow Label = "Remaining" Value = "@RemainingDisplay" />
                                        <DetailRow Label = "Time Left" Value = "@TextDisplay(Item?.TimeLeft)" />
                                        <DetailRow Label = "Download Percent"
                                                   Value = "@PercentDisplay(Item?.DownloadPercent)" />

                                        <div class = "detail-row border-bottom border-secondary-subtle">
                                            <span class = "data-label">Progress</span>
                                            <div class = "data-value d-flex align-items-center gap-2">
                                                <div class = "progress flex-grow-1" style = "height: 6px;">
                                                    <div class = "progress-bar"
                                                         style = "width: @ProgressPercent%"></div>
                                                </div>
                                                <span class = "text-muted small">@ProgressDisplay(ProgressPercent)</span>
                                            </div>
                                        </div>

                                    </div>

                                    <div class = "card">
                                        <div class = "card-header h3 fw-bold">
                                            Status
                                        </div>

                                        <DetailRow Label = "Status"
                                                   IsBadge = "true"
                                                   Value = "@StatusText"
                                                   BadgeClass = "@StatusBadgeClass(Item?.Status)" />
                                        <DetailRow Label = "Queue State" Value = "@EnumDisplay(Item?.State)" />
                                        <DetailRow Label = "Queue Status" Value = "@EnumDisplay(Item?.QueueStatus)" />
                                        <DetailRow Label = "Tracking State"
                                                   Value = "@EnumDisplay(Item?.TrackingState)" />
                                        <DetailRow Label = "Error Message" Value = "@TextDisplay(Item?.ErrorMessage)" />
                                        <DetailRow Label = "Attempt Key"
                                                   Value = "@TextDisplay(Item?.AttemptKey)"
                                                   Mono = "true" />
                                        <DetailRow Label = "Active Strikes"
                                                   Value = "@IntDisplay(Item?.ActiveStrikeCount)" />
                                        <DetailRow Label = "Total Strikes"
                                                   Value = "@IntDisplay(Item?.TotalStrikeCount)" />

                                        @if (Item?.StatusMessages.Count > 0) {
                                            <div class = "detail-row border-bottom border-secondary-subtle">
                                                <span class = "data-label">Status Messages</span>
                                                <div class = "data-value d-flex flex-column gap-2">
                                                    @foreach (StatusMessage message in Item.StatusMessages) {
                                                        <div>
                                                            <div class = "fw-semibold">@TextDisplay(message.Title)</div>
                                                            @if (message.Messages.Count > 0) {
                                                                <ul class = "mb-0 ps-3 text-secondary">
                                                                    @foreach (string text in message.Messages) {
                                                                        <li>@text</li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else {
                                            <DetailRow Label = "Status Messages" Value = "—" />
                                        }
                                    </div>
                                </div>
                            </div>

                            @* Issue / Next Action *@
                            @if (HasIssue || HasNextAction) {
                                <div class = "col-5">
                                    @if (HasIssue) {
                                        <div class = "info-panel info-panel--issue">
                                            <div class = "info-panel-header">
                                                <i class = "bi bi-exclamation-circle-fill text-danger me-2"></i>
                                                <span class = "fw-semibold">Issue</span>
                                            </div>
                                            <div class = "info-panel-title">@_issueTitle</div>
                                            <div class = "info-panel-body text-muted">@_issueBody</div>
                                        </div>
                                    }
                                </div>
                                <div class = "col-7">
                                    @if (HasNextAction) {
                                        <div class = "info-panel info-panel--action">
                                            <div class = "info-panel-header">
                                                <i class = "bi bi-lightning-fill text-primary me-2"></i>
                                                <span class = "fw-semibold">Next Action</span>
                                            </div>
                                            <div class = "info-panel-title">@_nextActionTitle</div>
                                            <div class = "info-panel-body text-muted">@_nextActionBody</div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    }
                </div>

                @* ── Footer ── *@
                <div class = "modal-footer">
                    <div class = "dropdown me-auto">
                        <button class = "btn btn-secondary dropdown-toggle" data-bs-toggle = "dropdown">
                            Mark as...
                        </button>
                        <ul class = "dropdown-menu">
                            <li>
                                <a class = "dropdown-item">Failed</a>
                            </li>
                            <li>
                                <a class = "dropdown-item">Completed</a>
                            </li>
                            <li>
                                <a class = "dropdown-item">Ignored</a>
                            </li>
                        </ul>
                    </div>
                    <button class = "btn btn-outline-danger" @onclick = "RemoveFromQueue">
                        <i class = "bi bi-trash me-1"></i>Remove from Queue
                    </button>
                    <button class = "btn btn-secondary" data-bs-dismiss = "modal">Close</button>
                    <button class = "btn btn-primary" @onclick = "ForceRecheck">
                        <i class = "bi bi-arrow-clockwise me-1"></i>Force Recheck
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

