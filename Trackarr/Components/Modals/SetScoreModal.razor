@using Trackarr.Services.Media
@inject IJSRuntime Js
@inject HealthService HealthService

<div id="setScoreModal" class="modal modal-blur fade" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Score</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (_item != null)
                {
                    <div class="mb-3">
                        <div class="text-secondary small mb-3 text-truncate">@_itemTitle</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Score
                            <span class="text-secondary fw-normal">(@_score)</span>
                        </label> <input type="range"
                                        class="form-range"
                                        min="0"
                                        max="100"
                                        @bind="_score"
                                        @bind:event="oninput"/>
                        <div class="d-flex justify-content-between text-secondary small">
                            <span>0</span>
                            <span>100</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confidence
                            <span class="text-secondary fw-normal">(@_confidence)</span>
                        </label> <input type="range"
                                        class="form-range"
                                        min="0"
                                        max="100"
                                        @bind="_confidence"
                                        @bind:event="oninput"/>
                        <div class="d-flex justify-content-between text-secondary small">
                            <span>0</span>
                            <span>100</span>
                        </div>
                    </div>

                    @if (_errorMessage != null)
                    {
                        <div class="alert alert-danger py-2 small">@_errorMessage</div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-app-ghost" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Apply
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
}
