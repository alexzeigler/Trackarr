@using Trackarr.Core.Server
@using Trackarr.Services.Media
@using Trackarr.Services.Settings
@inject IJSRuntime Js
@inject ServerRepository ServerRepository
@inject ServerConnectionService ServerConnection
@inject QualityProfileService QualityProfiles
@inject ServerSyncService ServerSync
@inject SettingsService Settings

<div id="serverModal" class="modal modal-blur fade" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header px-4 pt-4 pb-3 border-0">
                <div>
                    <h5 class="modal-title fw-bold mb-0 h1">@(IsEditing ? "Edit" : "Add") Server</h5>
                </div>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <div class="modal-body px-4 pb-2">

                @if (TestResult is not null)
                {
                    <div class="alert @(TestResult.Value.Item1 ? "alert-success" : "alert-danger") alert-important alert-dismissible d-flex align-items-start mb-4"
                         role="alert">
                        <div class="alert-icon h1">
                            @if (TestResult.Value.Item1)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="currentColor"
                                     class="icon icon-tabler icons-tabler-filled icon-tabler-circle-check">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="currentColor"
                                     class="icon icon-tabler icons-tabler-filled icon-tabler-exclamation-circle">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M17 3.34a10 10 0 1 1 -15 8.66l.005 -.324a10 10 0 0 1 14.995 -8.336m-5 11.66a1 1 0 0 0 -1 1v.01a1 1 0 0 0 2 0v-.01a1 1 0 0 0 -1 -1m0 -7a1 1 0 0 0 -1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0 -1 -1"/>
                                </svg>
                            }
                        </div>

                        <div class="flex-fill">
                            <div class="fw-bold mb-1">
                                @(TestResult.Value.Item1 ? "Connection successful" : "Connection failed")
                            </div>
                            <div>
                                @TestResult.Value.ReasonPhrase
                            </div>
                        </div>

                        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label">Application</label>
                        <div class="d-flex align-items-center gap-2">
                            <img src="./img/@(Model.ServiceType).svg" style="max-width: 40px"/>
                            <select class="form-select" @bind="Model.ServiceType" @bind:after="UpdatePort">
                                <option value="@ServiceType.Radarr">Radarr</option>
                                <option value="@ServiceType.Sonarr">Sonarr</option>
                            </select>
                        </div>
                        <div class="form-text">Select the *arr application to connect.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Name</label>
                        <input class="form-control @(string.IsNullOrWhiteSpace(Model.Name) ? "is-invalid" : "")"
                               placeholder="e.g. Radarr"
                               @bind="Model.Name"/>
                        <div class="form-text">A friendly name for this server.</div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-check form-switch form-switch-3">
                                <input class="form-check-input" type="checkbox" @bind="Model.IsEnabled">
                                <span class="form-check-label">Enabled</span>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="form-check form-switch form-switch-3">
                                <input class="form-check-input"
                                       type="checkbox"
                                       @bind="Model.UseHttps"
                                       @bind:after="UpdatePort">
                                <span class="form-check-label">Use SSL</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Base URL</label>
                    <div class="input-group">
                        <span class="input-group-text text-secondary">@(Model.UseHttps ? "https://" : "http://")</span>
                        <input class="form-control @(string.IsNullOrWhiteSpace(Model.Host) ? "is-invalid" : "")"
                               placeholder="hostname, IP, or paste a full URL"
                               @bind="Model.Host"
                               @bind:after="ParseAddress"/>
                        <span class="input-group-text">:</span>
                        <input type="number"
                               class="form-control @(Model.Port <= 0 ? "is-invalid" : "")"
                               style="max-width: 90px;"
                               @bind="Model.Port"/>
                        <input class="form-control"
                               style="max-width: 130px;"
                               placeholder="/url-base"
                               title="URL base, if @Model.ServiceType is served under a path (e.g. /radarr behind a reverse proxy)"
                               @bind="Model.UrlBase"/>
                    </div>
                    <div class="form-text">
                        @Model.BaseUrl &middot;
                        @if (Model.UseHttps)
                        {
                            <span>@Model.ServiceType's own SSL port is 9898; a reverse proxy is usually 443.</span>
                        }
                        else
                        {
                            <span>Paste a full URL (e.g. https://example.com/radarr) to fill these in.</span>
                        }
                    </div>
                </div>

                @if (Model.UseHttps)
                {
                    <div class="mb-3">
                        <label class="form-check form-switch form-switch-3">
                            <input class="form-check-input" type="checkbox" @bind="Model.SkipCertificateValidation">
                            <span class="form-check-label">Skip certificate validation</span>
                        </label>
                        <div class="form-text">
                            For self-signed certificates, such as @Model.ServiceType's built-in SSL. Only on a network you
                            trust: it stops Trackarr from checking it's talking to the real server.
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">API Key</label>
                    @* The saved key never goes into this field, so it never reaches the browser (AUDIT S2). *@
                    <div class="input-group">
                        <input class="form-control @(string.IsNullOrWhiteSpace(Model.ApiKey) ? "is-invalid" : "")"
                               type="@(_showApiKey ? "text" : "password")"
                               placeholder="@ApiKeyPlaceholder"
                               autocomplete="off"
                               @bind="_apiKeyInput" @bind:after="ApplyApiKey"/>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ToggleApiKey">
                            @if (_showApiKey)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16"
                                     height="16"
                                     fill="currentColor"
                                     viewBox="0 0 24 24">
                                    <path d="M12 5c-5 0-9.27 3.11-11 7 1.73 3.89 6 7 11 7s9.27-3.11 11-7c-1.73-3.89-6-7-11-7zm0 12a5 5 0 110-10 5 5 0 010 10z"/>
                                    <path d="M12 9a3 3 0 100 6 3 3 0 000-6z"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16"
                                     height="16"
                                     fill="currentColor"
                                     viewBox="0 0 24 24">
                                    <path d="M3.53 2.47a.75.75 0 00-1.06 1.06l18 18a.75.75 0 101.06-1.06l-18-18z"/>
                                    <path d="M22.676 12.553a11.249 11.249 0 01-2.631 4.31l-3.099-3.099a5.25 5.25 0 00-6.71-6.71L7.759 4.577a11.217 11.217 0 014.242-.827c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113z"/>
                                    <path d="M15.75 12c0 .18-.013.357-.037.53l-4.244-4.243A3.75 3.75 0 0115.75 12z"/>
                                    <path d="M12.53 15.713l-4.243-4.244a3.75 3.75 0 004.243 4.243z"/>
                                    <path d="M6.75 12c0-.619.107-1.213.304-1.764l-3.1-3.1a11.25 11.25 0 00-2.63 4.31c-.12.362-.12.752 0 1.114 1.489 4.467 5.704 7.69 10.675 7.69 1.5 0 2.933-.294 4.242-.827l-2.477-2.477A5.25 5.25 0 016.75 12z"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <div class="form-text">@ApiKeyHint</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label">Timeout</label>
                        <div class="input-group">
                            <input type="number"
                                   class="form-control"
                                   placeholder="Default"
                                   @bind="Model.RequestTimeoutSeconds"/>
                            <span class="input-group-text">sec</span>
                        </div>
                        <div class="form-text">Leave empty to use global default.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Priority</label>
                        <input type="number" class="form-control" @bind="Model.Priority"/>
                        <div class="form-text">Lower numbers run first.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label mb-2">Behavior Overrides
                        <span class="text-secondary fw-normal">— leave unset to use global defaults</span>
                    </label>
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="form-label small text-muted">Monitor Queue</label>
                            <select class="form-select form-select-sm" @bind="_monitorQueue">
                                <option value="">Use Default</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">Auto-Remove</label>
                            <select class="form-select form-select-sm" @bind="_autoRemove">
                                <option value="">Use Default</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">Search Missing</label>
                            <select class="form-select form-select-sm" @bind="_searchMissing">
                                <option value="">Use Default</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fallback Profile</label>
                    <div class="d-flex gap-2">
                        <span class="flex-fill"
                              id="fallbackTooltip"
                              data-bs-toggle="@(HasProfiles ? null : "tooltip")"
                              title="Test connection to load profiles">
                            <select @key="_fallbackSelectKey"
                                    class="form-select"
                                    id="fallbackProfileSelect"
                                    disabled="@(!HasProfiles)">
                                <option value="">None</option>
                                @foreach (var p in Profiles ?? [])
                                {
                                    <option value="@p.Name"
                                            selected="@(p.Name == Model.FallbackProfile?.Name)">@p.Name</option>
                                }
                            </select>
                        </span>
                        <button class="btn btn-app-ghost flex-shrink-0"
                                @onclick="TestConnection" disabled="@(!IsValid || IsBusy)">
                            @if (IsTesting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Test
                        </button>
                    </div>
                    <div class="form-text">Test connection to load available profiles.</div>
                </div>
            </div>

            <div class="modal-footer px-4 border-top border-secondary-subtle">
                <button class="btn btn-app-ghost me-auto" @onclick="Close" disabled="@IsBusy">
                    Cancel
                </button>
                <button class="btn btn-app-primary" @onclick="Save" disabled="@(!CanSave)">
                    @if (IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-floppy me-1"></i>
                    Save Server
                </button>
            </div>

        </div>
    </div>
</div>

