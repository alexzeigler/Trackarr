@using Trackarr.Core.Server
@using Trackarr.Services.Media
@inject IJSRuntime Js
@inject MediaServerService ServerService

<div id="serverModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">@(IsEditing ? "Edit" : "Add") @ServiceType Server</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
            </div>
            <div class="modal-body pt-3 pb-5">
                @if (TestResult is not null) {
                    <div class="alert @(TestResult.Value.Item1 ? "alert-success" : "alert-danger") py-2 small mb-3">
                        @TestResult.Value.ReasonPhrase
                    </div>
                }
                <div class="mb-3 form-check">
                    <input id="isEnabled" type="checkbox" class="form-check-input" @bind="Model.IsEnabled"/>
                    <label class="form-check-label" for="isEnabled"> Enabled </label>
                </div>
                <div class="mb-3 form-check">
                    <input id="isDefault" type="checkbox" class="form-check-input" @bind="Model.IsDefault"/>
                    <label class="form-check-label" for="isDefault"> Default Server </label>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small">Name
                        <span style="color: red">*</span>
                    </label>
                    <input
                            class="form-control bg-dark-subtle text-white border-secondary @(string.IsNullOrWhiteSpace(Model.Name) ? " is-invalid" : "")"
                            @bind="Model.Name"/>
                </div>

                <div class="row g-2 mb-3">
                    <label class="form-label text-secondary small">Hostname or IP Address
                        <span style="color: red">*</span>
                    </label>
                    <div class="col-8 input-group">
                        <span class="input-group-text rounded-start-0" id="basic-addon1">
                            @(Model.UseHttps ? "https://" : "http://")
                        </span>
                        <input
                                class="form-control bg-dark-subtle text-white border-secondary @(string.IsNullOrWhiteSpace(Model.Host) ? " is-invalid" : "")"
                                @bind="Model.Host"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label text-secondary small">Port
                            <span style="color: red">*</span>
                        </label>
                        <input type="number"
                               class="form-control bg-dark-subtle text-white border-secondary @(Model.Port <= 0 ? " is-invalid" : "")"
                               @bind="Model.Port"/>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="useHttps" @bind="Model.UseHttps"/>
                    <label class="form-check-label" for="useHttps"> Use HTTPS </label>
                </div>


                <div class="col-12">
                    <label class="form-label text-secondary small">API Key
                        <span style="color: red">*</span>
                    </label>
                    <div class="mb-3 input-group">
                        <input
                                class="form-control bg-dark-subtle text-white border-secondary @(string.IsNullOrWhiteSpace(Model.ApiKey) ? "is-invalid" : "")"
                                type="@(_showApiKey ? "text" : "password")" @bind="Model.ApiKey"/>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ToggleApiKey">
                            @if (_showApiKey) {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                     viewBox="0 0 24 24">
                                    <path
                                            d="M12 5c-5 0-9.27 3.11-11 7 1.73 3.89 6 7 11 7s9.27-3.11 11-7c-1.73-3.89-6-7-11-7zm0 12a5 5 0 110-10 5 5 0 010 10z"/>
                                    <path d="M12 9a3 3 0 100 6 3 3 0 000-6z"/>
                                </svg>
                            }
                            else {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                     viewBox="0 0 24 24">
                                    <path d="M3.53 2.47a.75.75 0 00-1.06 1.06l18 18a.75.75 0 101.06-1.06l-18-18z"/>
                                    <path
                                            d="M22.676 12.553a11.249 11.249 0 01-2.631 4.31l-3.099-3.099a5.25 5.25 0 00-6.71-6.71L7.759 4.577a11.217 11.217 0 014.242-.827c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113z"/>
                                    <path d="M15.75 12c0 .18-.013.357-.037.53l-4.244-4.243A3.75 3.75 0 0115.75 12z"/>
                                    <path d="M12.53 15.713l-4.243-4.244a3.75 3.75 0 004.243 4.243z"/>
                                    <path
                                            d="M6.75 12c0-.619.107-1.213.304-1.764l-3.1-3.1a11.25 11.25 0 00-2.63 4.31c-.12.362-.12.752 0 1.114 1.489 4.467 5.704 7.69 10.675 7.69 1.5 0 2.933-.294 4.242-.827l-2.477-2.477A5.25 5.25 0 016.75 12z"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label text-secondary small">Fallback Profile</label>
                    <span class="text-secondary" data-bs-toggle="tooltip"
                          data-bs-title="Test connection to get a list of available profiles">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                             class="bi bi-info-circle-fill" viewBox="0 0 16 16">
                            <path
                                    d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                        </svg>

                    </span>
                    @if (Profiles != null) {
                        <select class="form-select" @bind="Model.FallbackProfile">
                            <option value=""></option>
                            @foreach (QualityProfile profile in Profiles) {
                                <option value="@profile.Name">@profile.Name</option>
                            }
                        </select>
                    }
                </div>

            </div>

            <div class="modal-footer border-secondary">
                <button class="btn btn-outline-secondary" @onclick="Close" disabled="@IsBusy">
                    Cancel
                </button>
                <button class="btn btn-outline-info" @onclick="TestConnection" disabled="@IsBusy">
                    @if (IsTesting) {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Test Connection
                </button>
                <button class="btn btn-indigo" @onclick="Save" disabled="@(!CanSave)">
                    @if (IsSaving) {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ServiceType ServiceType { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private MediaServer Model { get; set; } = new();
    private bool IsEditing => Model.Id != 0;
    private bool IsTesting { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsTesting || IsSaving;
    private bool IsValid => !string.IsNullOrWhiteSpace(Model.Name) && !string.IsNullOrWhiteSpace(Model.Host) && Model.Port > 0 && !string.IsNullOrWhiteSpace(Model.ApiKey);
    private bool CanSave => IsValid && TestResult is { Item1: true } && !IsBusy;
    private List<QualityProfile>? Profiles { get; set; } = [];

    private (bool, long ElapsedMilliseconds, string? ReasonPhrase)? TestResult { get; set; }
    private bool _showApiKey;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await Js.InvokeVoidAsync("initTooltips");
        }
    }

    private void ToggleApiKey() {
        _showApiKey = !_showApiKey;
    }

    public async Task OpenForAdd(ServiceType type) {
        ServiceType = type;

        Model = new MediaServer {
            IsEnabled = true,
            ServiceType = type,
            Port = type switch {
                ServiceType.Radarr => 7878,
                ServiceType.Sonarr => 8989,
                _ => 80
            },
            CreatedAt = DateTime.UtcNow
        };

        TestResult = null;
        _showApiKey = false;

        await InvokeAsync(StateHasChanged);

        await Js.InvokeVoidAsync("modalHelper.show", "serverModal");
    }

    public async Task OpenForEdit(MediaServer server) {
        ServiceType = server.ServiceType;
        Model = server.Clone();
        if (!string.IsNullOrWhiteSpace(Model.FallbackProfile)) {
            Profiles = server.Profiles;
            QualityProfile? selected = Profiles?.FirstOrDefault(p => string.Equals(p.Name, Model.FallbackProfile, StringComparison.OrdinalIgnoreCase));
            if (selected == null) {
                TestResult = new ValueTuple<bool, long, string?>(false, 0, $"Profile does not exist on the server: \"{Model.FallbackProfile}\".");
            }
        }
        else {
            Profiles?.Clear();
            TestResult = null;
        }

        _showApiKey = false;
        await InvokeAsync(StateHasChanged);

        await Js.InvokeVoidAsync("modalHelper.show", "serverModal");
    }

    private async Task TestConnection() {
        IsTesting = true;
        TestResult = null;
        Model.ServiceType = ServiceType;

        TestResult = await ServerService.TestConnectionAsync(Model);

        if (TestResult is { Item1: true }) {
            Model.LastPingTime = TestResult.Value.ElapsedMilliseconds;
            Model.LastPingSuccessful = true;
            TestResult = TestResult.Value with { ReasonPhrase = $"{TestResult.Value.ReasonPhrase} Last ping time: {TestResult.Value.ElapsedMilliseconds}ms" };
            Profiles = await ServerService.GetProfilesAsync(Model);
        }
        else {
            Profiles?.Clear();
        }

        IsTesting = false;
    }

    private async Task Save() {
        IsSaving = true;
        Model.ServiceType = ServiceType;

        if (IsEditing) {
            await ServerService.UpdateServerAsync(Model);
        }
        else {
            await ServerService.CreateServerAsync(Model);
        }

        IsSaving = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        await InvokeAsync(StateHasChanged);
        await OnSaved.InvokeAsync();
        await Js.InvokeVoidAsync("modalHelper.hide", "serverModal");
    }

    private async Task Close() {
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        TestResult = null;
        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("modalHelper.hide", "serverModal");
    }

}