@page "/servers"
@inject IJSRuntime Js
@inject MediaServerService MediaServerService
@using Trackarr.Components.Modals
@using Trackarr.Services.Media
@using static Utils
@implements IAsyncDisposable

<AddServerModal @ref="_serverModal"/>
<ConfirmationDialog @ref="_confirmModal" Text="@_confirmText" OnConfirm="@(() => SendDeleteToDb(_selectedServerId))"/>

<div class="d-flex flex-column gap-3">
    <div class="subheader mt-2 mb-2">Server Overview</div>
    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Servers</div>
                    <div class="h1 mb-0">@_servers.Count</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="subheader">Online</div>
                        @if (_servers.Count > 0)
                        {
                            var allOnline = _servers.All(s => s.IsOnline);
                            <div class="ms-auto d-flex align-items-center @(allOnline ? "text-green" : "text-red")">
                                <i class="@(allOnline ? "ti ti-circle-check" : "ti ti-alert-triangle")"></i>
                            </div>
                        }
                    </div>
                    <div class="h1 mb-0">@_servers.Count(x => x.IsOnline) / @_servers.Count</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="subheader">Verified</div>
                        @if (_servers.Count > 0)
                        {
                            var allAuth = _servers.All(s => s.IsAuthenticated);
                            <div class="ms-auto d-flex align-items-center @(allAuth ? "text-green" : "text-red")">
                                <i class="@(allAuth ? "ti ti-circle-check" : "ti ti-alert-triangle")"></i>
                            </div>
                        }
                    </div>
                    <div class="h1 mb-0">@_servers.Count(x => x.IsAuthenticated) / @_servers.Count</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Total in Queue</div>
                    <div class="h1 mb-0">@(_servers.Sum(x => x.LastQueueCount ?? 0))</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Total Missing</div>
                    <div class="h1 mb-0">@(_servers.Sum(x => x.LastMissingCount ?? 0))</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Last Sync</div>
                    <div class="h1 mb-0">@(_servers.Count == 0 ? "—" : TimeAgo(_servers.Max(x => x.LastQueueFetchAt)))</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card app-card">
        <div class="card-header">
            <div class="d-flex flex-wrap align-items-center gap-2 w-100">
                <div class="ms-auto d-flex flex-wrap btn-list">
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-app-ghost" @onclick="ClearFilters">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon m-0 me-1">
                                <path d="M18 6l-12 12"/>
                                <path d="M6 6l12 12"/>
                            </svg>
                            Clear
                        </button>
                    }

                    <select class="form-select w-auto" @onchange="OnTypeFilterChanged">
                        <option value="" selected="@(_typeFilter == null)">All Types</option>
                        @foreach (var type in AvailableTypes)
                        {
                            <option value="@type" selected="@(_typeFilter == type)">@type</option>
                        }
                    </select>

                    <select class="form-select w-auto" @onchange="OnStatusFilterChanged">
                        <option value="" selected="@(_statusFilter == null)">All Statuses</option>
                        <option value="online" selected="@(_statusFilter == "online")">Online</option>
                        <option value="offline" selected="@(_statusFilter == "offline")">Offline</option>
                        <option value="error" selected="@(_statusFilter == "error")">Error</option>
                        <option value="disabled" selected="@(_statusFilter == "disabled")">Disabled</option>
                    </select>

                    <button class="btn btn-app-primary" @onclick="AddServer">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="icon m-0 me-1">
                            <path d="M12 5l0 14"/>
                            <path d="M5 12l14 0"/>
                        </svg>
                        Add Server
                    </button>

                    <button class="btn btn-app-ghost" @onclick="SyncAll" disabled="@IsRefreshing">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="icon icon-tabler icon-tabler-refresh m-0 @(IsRefreshing ? "spinner" : "")">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                            <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                        </svg>
                    </button>

                    <div class="input-group input-group-flat w-auto">
                        <span class="input-group-text">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon icon-1">
                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                                <path d="M21 21l-6 -6"></path>
                            </svg>
                        </span>
                        <input type="text"
                               class="form-control form-control-sm"
                               autocomplete="off"
                               placeholder="Search servers..."
                               value="@_searchTerm"
                               @oninput="OnSearchChanged">
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter table-nowrap">
                <thead>
                <tr>
                    <th>
                        <button class="@SortClass("name")" @onclick='() => SortBy("name")'>Server</button>
                    </th>
                    <th style="width: 90px">
                        <button class="@SortClass("type")" @onclick='() => SortBy("type")'>Type</button>
                    </th>
                    <th style="width: 80px">
                        <button class="@SortClass("status")" @onclick='() => SortBy("status")'>Status</button>
                    </th>
                    <th style="width: 75px" class="text-end">
                        <button class="@SortClass("queue")" @onclick='() => SortBy("queue")'>Queue</button>
                    </th>
                    <th style="width: 75px" class="text-end">
                        <button class="@SortClass("missing")" @onclick='() => SortBy("missing")'>Missing</button>
                    </th>
                    <th style="width: 75px" class="text-end">
                        <button class="@SortClass("ping")" @onclick='() => SortBy("ping")'>Ping</button>
                    </th>
                    <th style="width: 100px" class="text-end">
                        <button class="@SortClass("sync")" @onclick='() => SortBy("sync")'>Last Sync</button>
                    </th>
                    <th style="width: 90px">
                        <button class="@SortClass("version")" @onclick='() => SortBy("version")'>Version</button>
                    </th>
                    <th style="width: 130px" class="text-end"></th>
                </tr>
                </thead>
                <tbody class="table-tbody">
                @if (FilteredServers.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No servers found</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in FilteredServers)
                    {
                        <tr @key="row.Id" class="@(!row.IsEnabled ? "server-disabled" : "")">
                            <td>
                                <div class="item-title-cell">
                                    @GetServerIcon(row.ServiceType)
                                    <div>
                                        <div class="item-title fw-semibold">@row.Name</div>
                                        <div class="item-meta">
                                            <a href="@row.BaseUrl"
                                               target="_blank"
                                               class="text-secondary text-decoration-none">
                                                @row.BaseUrl
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(row.FallbackProfile?.Name))
                                            {
                                                <span class="text-secondary ms-2">
                                                    Fallback: @row.FallbackProfile.Name</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="@GetTypeBadgeClass(row.ServiceType)">@row.ServiceType</span>
                            </td>

                            <td>
                                <span class="@GetServerStatusBadge(row)">@GetServerStatusText(row)</span>
                            </td>

                            <td class="text-end fw-semibold">
                                @IntDisplay(row.LastQueueCount)
                            </td>

                            <td class="text-end fw-semibold">
                                @IntDisplay(row.LastMissingCount)
                            </td>

                            <td class="text-end text-secondary">
                                @(row.LastPingMs.HasValue ? $"{row.LastPingMs}ms" : "—")
                            </td>

                            <td class="text-end text-secondary" title="@DateTimeDisplay(row.LastQueueFetchAt)">
                                @TimeAgo(row.LastQueueFetchAt)
                            </td>

                            <td class="text-secondary text-nowrap">
                                @(row.Metadata?.Version ?? "—")
                            </td>

                            <td class="text-end">
                                <div class="btn-group" @onclick:stopPropagation="true">
                                    <button class="btn btn-app-ghost btn-sm" @onclick="() => EditServer(row)">
                                        Edit
                                    </button>
                                    <button data-bs-toggle="dropdown"
                                            data-bs-strategy="fixed"
                                            type="button"
                                            class="btn btn-app-ghost btn-sm dropdown-toggle dropdown-toggle-split"
                                            aria-expanded="false"></button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <button class="dropdown-item" type="button" @onclick="() => ToggleEnabled(row)">
                                            @(row.IsEnabled ? "Disable" : "Enable")
                                        </button>
                                        <button class="dropdown-item" type="button" @onclick="() => SyncServer(row)">
                                            Sync Now
                                        </button>
                                        <button class="dropdown-item"
                                                type="button"
                                                @onclick="() => TestConnection(row)">
                                            Test Connection
                                        </button>
                                        <div class="dropdown-divider"></div>
                                        <button class="dropdown-item text-danger"
                                                type="button"
                                                @onclick="() => RemoveServer(row)">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center justify-content-end">
            <div class="fw-semibold">@FilteredServers.Count of @_servers.Count servers</div>
        </div>
    </div>
</div>
