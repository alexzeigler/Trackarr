@page "/system/status"
@inject SystemStatusService StatusService
@using Trackarr.Core.SystemInfo
@using Trackarr.Services.SystemInfo
@implements IDisposable

<PageTitle>Status</PageTitle>

<div class="d-flex flex-column gap-3">

    @* ── App Info ──────────────────────────────────────────────────────────── *@
    @if (_appInfo is not null)
    {
        <div class="card app-card">
            <div class="card-body py-2">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted">Version</span>
                        <span class="fw-bold">@_appInfo.Version</span>
                        @if (_appInfo.BuildTime != DateTime.MinValue)
                        {
                            <span class="text-muted">&middot;</span>
                            <span class="text-muted">Built @FormatBuildTime(_appInfo.BuildTime)</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">Uptime</span>
                        <span class="fw-bold">@FormatUptime(_appInfo.Uptime)</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Health ─────────────────────────────────────────────────────────────── *@
    <div class="card app-card">
        <div class="card-header">
            <h3 class="card-title">Health</h3>
            <div class="card-actions">
                <button type="button" class="btn btn-app-ghost btn-sm" disabled="@_isRefreshing" @onclick="LoadAsync">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="icon m-0 @(_isRefreshing ? "spinner" : "")">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                        <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                    </svg>
                </button>
            </div>
        </div>
        @if (_messages.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-vcenter table-nowrap mb-0">
                    <thead>
                    <tr>
                        <th class="w-1"></th>
                        <th>Message</th>
                    </tr>
                    </thead>
                    <tbody class="table-tbody">
                    @foreach (var msg in _messages)
                    {
                        <tr>
                            <td>
                                <i class="@StatusIcon(msg.Level)" title="@msg.Level"></i>
                            </td>
                            <td>
                                <span class="@StatusTextClass(msg.Level)">@msg.Message</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center py-4">
                <i class="ti ti-circle-check text-success fs-1"></i>
                <div class="mt-2 text-muted">All systems operational</div>
            </div>
        }
    </div>

</div>

@code {
    private AppInfo? _appInfo;
    private List<SystemStatusMessage> _messages = [];
    private bool _isRefreshing;
    private Timer? _uptimeTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _uptimeTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task LoadAsync()
    {
        _isRefreshing = true;
        try
        {
            _appInfo = await StatusService.GetAppInfoAsync();
            _messages = await StatusService.GetStatusMessagesAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private static string StatusIcon(StatusLevel level)
    {
        return level switch
        {
            StatusLevel.Error => "ti ti-circle-x-filled text-danger fs-3",
            StatusLevel.Warning => "ti ti-alert-triangle-filled text-warning fs-3",
            StatusLevel.Notice => "ti ti-info-circle-filled text-info fs-3",
            _ => "ti ti-info-circle text-muted fs-3"
        };
    }

    private static string StatusTextClass(StatusLevel level)
    {
        return level switch
        {
            StatusLevel.Error => "text-danger",
            StatusLevel.Warning => "text-warning",
            _ => ""
        };
    }

    private static string FormatUptime(TimeSpan ts)
    {
        if (ts.TotalDays >= 1) return $"{(int)ts.TotalDays}d {ts.Hours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}";
        return $"{ts.Hours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}";
    }

    private static string FormatBuildTime(DateTime utc)
    {
        return utc.ToLocalTime().ToString("MMM d, yyyy");
    }

    public void Dispose()
    {
        _uptimeTimer?.Dispose();
    }
}
