@page "/history"
@using Trackarr.Core.Queue
@using Trackarr.Core.UI

<PageTitle>History</PageTitle>

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">History</h2>
            <div class="text-secondary mt-1">View past download activity, events, and changes.</div>
        </div>
    </div>
</div>

<div class="page-body">

    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-xl-2">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar bg-purple-lt me-3">
                            <i class="ti ti-arrow-down"></i>
                        </span>
                        <div>
                            <div class="text-secondary small">Total Downloads</div>
                            <div class="h2 mb-0">@FormatNumber(_data.Stats.TotalDownloads)</div>
                            <div class="text-secondary small">All time</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar bg-success-lt me-3">
                            <i class="ti ti-circle-check"></i>
                        </span>
                        <div>
                            <div class="text-secondary small">Completed</div>
                            <div class="h2 mb-0">@FormatNumber(_data.Stats.Completed)</div>
                            <div class="text-secondary small">@FormatPercent(_data.Stats.CompletedPercent)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar bg-danger-lt me-3">
                            <i class="ti ti-x"></i>
                        </span>
                        <div>
                            <div class="text-secondary small">Failed</div>
                            <div class="h2 mb-0">@FormatNumber(_data.Stats.Failed)</div>
                            <div class="text-secondary small">@FormatPercent(_data.Stats.FailedPercent)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar bg-orange-lt me-3">
                            <i class="ti ti-trash"></i>
                        </span>
                        <div>
                            <div class="text-secondary small">Removed</div>
                            <div class="h2 mb-0">@FormatNumber(_data.Stats.Removed)</div>
                            <div class="text-secondary small">@FormatPercent(_data.Stats.RemovedPercent)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar bg-blue-lt me-3">
                            <i class="ti ti-clock"></i>
                        </span>
                        <div>
                            <div class="text-secondary small">Avg. Time to Completion</div>
                            <div class="h2 mb-0">@FormatDuration(_data.Stats.AverageCompletionTime)</div>
                            <div class="text-secondary small">Selected range</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar bg-purple-lt me-3">
                            <i class="ti ti-server"></i>
                        </span>
                        <div>
                            <div class="text-secondary small">Data Downloaded</div>
                            <div class="h2 mb-0">@FormatBytes(_data.Stats.DataDownloaded)</div>
                            <div class="text-secondary small">Selected range</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-2">
                    <input type="date"
                           class="form-control"
                           value="@_fromDate.ToString("yyyy-MM-dd")"
                           @onchange="OnFromDateChanged"/>
                </div>

                <div class="col-md-2">
                    <input type="date"
                           class="form-control"
                           value="@_toDate.ToString("yyyy-MM-dd")"
                           @onchange="OnToDateChanged"/>
                </div>

                <div class="col-md-2">
                    <select class="form-select" @onchange="OnServerChanged">
                        <option value="">All Servers</option>
                        @foreach (var server in _servers)
                        {
                            <option value="@server.Id" selected="@(_serverFilter == server.Id)">@server.Name</option>
                        } </select>
                </div>

                <div class="col-md-2">
                    <select class="form-select" @onchange="OnTypeChanged">
                        <option value="">All Categories</option>
                        @foreach (var type in _mediaTypes)
                        {
                            <option value="@type" selected="@(_typeFilter == type)">@type</option>
                        } </select>
                </div>

                <div class="col-md-2">
                    <select class="form-select" @onchange="OnStatusChanged">
                        <option value="">All Statuses</option>
                        @foreach (var status in _statuses)
                        {
                            <option value="@status" selected="@(_statusFilter == status)">@status</option>
                        } </select>
                </div>

                <div class="col-md-2">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input id="history-table-search"
                               type="text"
                               class="form-control"
                               placeholder="Search history..."/>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cards mb-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Activity Over Time</h3>
                </div>
                <div class="card-body">
                    <div id="history-activity-chart" class="chart-lg"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Activity Breakdown</h3>
                </div>
                <div class="card-body">
                    <ChartHost Id="history-breakdown-chart" Class="chart-lg"/>

                    <div class="mt-3">
                        @foreach (var item in _data.Breakdown)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge @BreakdownDotClass(item.Label) me-2">&nbsp;</span>
                                <div class="flex-fill">@item.Label</div>
                                <div class="text-secondary">@FormatNumber(item.Count) (@FormatPercent(item.Percent))</div>
                            </div>
                        }

                        @if (_data.Breakdown.Count == 0)
                        {
                            <div class="empty">
                                <div class="empty-icon">
                                    <i class="ti ti-chart-pie"></i>
                                </div>
                                <p class="empty-title">No breakdown data</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="history-table" class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <button type="button"
                            class="@TabClass(HistoryTab.DownloadEvents)"
                            @onclick="() => SetTab(HistoryTab.DownloadEvents)">
                        <i class="ti ti-download me-2"></i>Download Events
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button"
                            class="@TabClass(HistoryTab.Events)"
                            @onclick="() => SetTab(HistoryTab.Events)">
                        <i class="ti ti-clipboard-list me-2"></i>Events
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button"
                            class="@TabClass(HistoryTab.Searches)"
                            @onclick="() => SetTab(HistoryTab.Searches)">
                        <i class="ti ti-search me-2"></i>Searches
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button"
                            class="@TabClass(HistoryTab.Health)"
                            @onclick="() => SetTab(HistoryTab.Health)">
                        <i class="ti ti-heartbeat me-2"></i>Health
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button"
                            class="@TabClass(HistoryTab.Changes)"
                            @onclick="() => SetTab(HistoryTab.Changes)">
                        <i class="ti ti-history me-2"></i>Changes
                    </button>
                </li>
            </ul>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter table-nowrap card-table">
                <thead>
                <tr>
                    <th>
                        <button class="table-sort" data-sort="sort-date">Date / Time</button>
                    </th>
                    <th>
                        <button class="table-sort" data-sort="sort-event">Event</button>
                    </th>
                    <th>
                        <button class="table-sort" data-sort="sort-item">Item</button>
                    </th>
                    <th>
                        <button class="table-sort" data-sort="sort-type">Type</button>
                    </th>
                    <th>
                        <button class="table-sort" data-sort="sort-server">Server</button>
                    </th>
                    <th>
                        <button class="table-sort" data-sort="sort-profile">Profile</button>
                    </th>
                    <th>
                        <button class="table-sort" data-sort="sort-status">Status</button>
                    </th>
                    <th>Details</th>
                </tr>
                </thead>
                <StaticRegion>
                    <tbody class="table-tbody list">
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-secondary py-4">
                                <div class="spinner-border spinner-border-sm me-2"></div>
                                Loading history...
                            </td>
                        </tr>
                    }
                    else if (!FilteredRows.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-secondary py-4">No history entries found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in FilteredRows)
                        {
                            <tr>
                                <td class="sort-date" data-sort="@row.SortValue">@FormatDate(row.OccurredAt)</td>
                                <td class="sort-event">
                                    <span class="@EventIconClass(row)">
                                        <i class="@EventIcon(row)"></i>
                                    </span>
                                    <span class="ms-2">@row.Event</span>
                                </td>
                                <td class="sort-item">
                                    <div class="d-flex align-items-center">
                                        <span class="avatar avatar-xs me-2">
                                            <i class="ti ti-photo"></i>
                                        </span>
                                        <span>@row.Item</span>
                                    </div>
                                </td>
                                <td class="sort-type">
                                    <span class="@TypeBadgeClass(row.MediaType)">@DisplayType(row.MediaType)</span>
                                </td>
                                <td class="sort-server">@row.Server</td>
                                <td class="sort-profile">@row.Profile</td>
                                <td class="sort-status">
                                    <span class="@StatusBadgeClass(row.Status)">@row.Status</span>
                                </td>
                                <td class="sort-details text-secondary">@row.Details</td>
                            </tr>
                        }
                    }
                    </tbody>
                </StaticRegion>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-secondary">
                Showing
                <span id="history-page-count">@FilteredRows.Count()</span>
                of @FormatNumber(FilteredRows.Count()) events
            </p>
            <ul class="pagination m-0 ms-auto"></ul>
        </div>
    </div>
</div>