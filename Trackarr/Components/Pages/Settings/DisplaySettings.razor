@page "/settings/display"
@using Trackarr.Core.UI
@using Trackarr.Services.Settings
@layout SettingsLayout
@inject SettingsService SettingsService

<h2 class="mb-1">Display</h2>
<p class="text-muted mb-4">Customize dates, tables, and visual elements.</p>

<h3 class="settings-section-title">Date &amp; Time</h3>
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Format used for absolute timestamps throughout the application">
            Date Format
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <select class="form-select" @bind="_dateFormat" @bind:after="MarkDirty">
            <option value="MMM d, yyyy h:mm tt">Jun 22, 2026 3:45 PM</option>
            <option value="yyyy-MM-dd HH:mm">2026-06-22 15:45</option>
            <option value="dd/MM/yyyy HH:mm">22/06/2026 15:45</option>
            <option value="MM/dd/yyyy h:mm tt">06/22/2026 3:45 PM</option>
            <option value="d MMM yyyy HH:mm">22 Jun 2026 15:45</option>
        </select>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label d-block"
               data-bs-toggle="tooltip"
               title="Show relative time like '5m ago' instead of absolute dates">
            Friendly Time
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <label class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" @bind="_useTimeAgo" @bind:after="MarkDirty"/>
            <span class="form-check-label">Use "time ago" format</span>
        </label>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip" title="After this many hours, show the absolute date instead of 'time ago'">
            Time Ago Threshold
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="1"
                   max="168"
                   @bind="_timeAgoThreshold"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">hrs</span>
        </div>
    </div>
</div>

<hr class="settings-divider"/>
<h3 class="settings-section-title">Page Sizes</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Number of items per page on the Queue view">
            Queue
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <select class="form-select" @bind="_queuePageSize" @bind:after="MarkDirty">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Number of items per page on the Missing view">
            Missing
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <select class="form-select" @bind="_missingPageSize" @bind:after="MarkDirty">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Number of items per page on the History view">
            History
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <select class="form-select" @bind="_historyPageSize" @bind:after="MarkDirty">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Number of items per page on the Events view">
            Events
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <select class="form-select" @bind="_eventsPageSize" @bind:after="MarkDirty">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

<hr class="settings-divider"/>
<h3 class="settings-section-title">Table Density</h3>
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Controls row padding and which visual elements are shown in tables">
            Density
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="btn-group w-100" role="group">
            <input type="radio"
                   class="btn-check"
                   name="density"
                   id="dCompact"
                   checked="@(_tableDensity == "compact")"
                   @onchange="@(() => SetDensity("compact"))"/>
            <label class="btn btn-app-ghost" for="dCompact">Compact</label>
            <input type="radio"
                   class="btn-check"
                   name="density" id="dNormal" checked="@(_tableDensity == "normal")"
                   @onchange="@(() => SetDensity("normal"))"/>
            <label class="btn btn-app-ghost" for="dNormal">Normal</label>
            <input type="radio"
                   class="btn-check"
                   name="density"
                   id="dComfy"
                   checked="@(_tableDensity == "comfortable")"
                   @onchange="@(() => SetDensity("comfortable"))"/>
            <label class="btn btn-app-ghost" for="dComfy">Comfortable</label>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <label class="form-label d-block"
               data-bs-toggle="tooltip"
               title="Show movie and series poster thumbnails in table rows">
            Poster Images
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <label class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" @bind="_showPosterImages" @bind:after="MarkDirty"/>
            <span class="form-check-label">Show poster images</span>
        </label>
    </div>
</div>

<hr class="settings-divider"/>
<h3 class="settings-section-title">Visual Elements</h3>
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <label class="form-label" data-bs-toggle="tooltip" title="Toggle chart visibility on data pages">
            Charts
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="d-flex gap-4 mt-2">
            <label class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked="@_showQueueCharts" @onchange="@(e =>
                                                                                                       {
                                                                                                           _showQueueCharts = (bool)e.Value!;
                                                                                                           MarkDirty();
                                                                                                       })"/>
                <span class="form-check-label">Queue Charts</span>
            </label>
            <label class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked="@_showMissingCharts" @onchange="@(e =>
                                                                                                         {
                                                                                                             _showMissingCharts = (bool)e.Value!;
                                                                                                             MarkDirty();
                                                                                                         })"/>
                <span class="form-check-label">Missing Charts</span>
            </label>
        </div>
    </div>
</div>

<hr class="settings-divider"/>
<h3 class="settings-section-title">Queue Grouping</h3>
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="How queue items are grouped by default when viewing the queue page">
            Default Grouping
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <select class="form-select" @bind="_defaultGrouping" @bind:after="MarkDirty">
            <option value="mediaTitle">By Media Title</option>
            <option value="none">None</option>
            <option value="server">By Server</option>
            <option value="status">By Status</option>
            <option value="mediaType">By Media Type</option>
        </select>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label d-block"
               data-bs-toggle="tooltip"
               title="Automatically expand all groups when the queue page loads">
            Expand Groups
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <label class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" @bind="_expandGroups" @bind:after="MarkDirty"/>
            <span class="form-check-label">Expand groups by default</span>
        </label>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="How often pages sync in the background to catch external changes. Local actions update instantly.">
            Background Sync
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="5"
                   max="300"
                   @bind="_queueRefreshInterval"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">sec</span>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private SettingsPageContext Context { get; set; } = null!;

    private string _dateFormat = "";
    private bool _useTimeAgo;
    private int _timeAgoThreshold;
    private int _queuePageSize;
    private int _missingPageSize;
    private int _historyPageSize;
    private int _eventsPageSize;
    private string _tableDensity = "";
    private bool _showQueueCharts;
    private bool _showMissingCharts;
    private bool _showPosterImages;
    private string _defaultGrouping = "";
    private bool _expandGroups;
    private int _queueRefreshInterval;

    private string _origDateFormat = "";
    private bool _origUseTimeAgo;
    private int _origTimeAgoThreshold;
    private int _origQueuePageSize;
    private int _origMissingPageSize;
    private int _origHistoryPageSize;
    private int _origEventsPageSize;
    private string _origTableDensity = "";
    private bool _origShowQueueCharts;
    private bool _origShowMissingCharts;
    private bool _origShowPosterImages;
    private string _origDefaultGrouping = "";
    private bool _origExpandGroups;
    private int _origQueueRefreshInterval;

    protected override void OnInitialized()
    {
        LoadValues();
        Context.SaveAsync = SaveAsync;
        Context.DiscardAsync = DiscardAsync;
        Context.NotifyChanged();
    }

    private void LoadValues()
    {
        _dateFormat = SettingsService.GetString("Display", "DateFormat", "MMM d, yyyy h:mm tt");
        _useTimeAgo = SettingsService.GetBool("Display", "UseTimeAgo", true);
        _timeAgoThreshold = SettingsService.GetInt("Display", "TimeAgoThresholdHours", 24);
        _queuePageSize = SettingsService.GetInt("Display", "QueuePageSize", 10);
        _missingPageSize = SettingsService.GetInt("Display", "MissingPageSize", 10);
        _historyPageSize = SettingsService.GetInt("Display", "HistoryPageSize", 25);
        _eventsPageSize = SettingsService.GetInt("Display", "EventsPageSize", 50);
        _tableDensity = SettingsService.GetString("Display", "TableDensity", "normal");
        _showQueueCharts = SettingsService.GetBool("Display", "ShowQueueCharts", true);
        _showMissingCharts = SettingsService.GetBool("Display", "ShowMissingCharts", true);
        _showPosterImages = SettingsService.GetBool("Display", "ShowPosterImages", true);
        _defaultGrouping = SettingsService.GetString("Display", "DefaultQueueGrouping", "mediaTitle");
        _expandGroups = SettingsService.GetBool("Display", "ExpandQueueGroupsByDefault", true);
        _queueRefreshInterval = SettingsService.GetInt("Display", "QueueRefreshIntervalSeconds", 10);

        _origDateFormat = _dateFormat;
        _origUseTimeAgo = _useTimeAgo;
        _origTimeAgoThreshold = _timeAgoThreshold;
        _origQueuePageSize = _queuePageSize;
        _origMissingPageSize = _missingPageSize;
        _origHistoryPageSize = _historyPageSize;
        _origEventsPageSize = _eventsPageSize;
        _origTableDensity = _tableDensity;
        _origShowQueueCharts = _showQueueCharts;
        _origShowMissingCharts = _showMissingCharts;
        _origShowPosterImages = _showPosterImages;
        _origDefaultGrouping = _defaultGrouping;
        _origExpandGroups = _expandGroups;
        _origQueueRefreshInterval = _queueRefreshInterval;
    }

    private void SetDensity(string value)
    {
        _tableDensity = value;
        MarkDirty();
    }

    private void MarkDirty()
    {
        Context.HasChanges = _dateFormat != _origDateFormat || _useTimeAgo != _origUseTimeAgo || _timeAgoThreshold != _origTimeAgoThreshold || _queuePageSize != _origQueuePageSize || _missingPageSize != _origMissingPageSize || _historyPageSize != _origHistoryPageSize || _eventsPageSize != _origEventsPageSize || _tableDensity != _origTableDensity || _showQueueCharts != _origShowQueueCharts || _showMissingCharts != _origShowMissingCharts || _showPosterImages != _origShowPosterImages || _defaultGrouping != _origDefaultGrouping || _expandGroups != _origExpandGroups || _queueRefreshInterval != _origQueueRefreshInterval;
        Context.NotifyChanged();
    }

    private async Task SaveAsync()
    {
        await SettingsService.SaveCategoryAsync("Display", new Dictionary<string, string>
        {
            ["DateFormat"] = _dateFormat,
            ["UseTimeAgo"] = _useTimeAgo.ToString(),
            ["TimeAgoThresholdHours"] = _timeAgoThreshold.ToString(),
            ["QueuePageSize"] = _queuePageSize.ToString(),
            ["MissingPageSize"] = _missingPageSize.ToString(),
            ["HistoryPageSize"] = _historyPageSize.ToString(),
            ["EventsPageSize"] = _eventsPageSize.ToString(),
            ["TableDensity"] = _tableDensity,
            ["ShowQueueCharts"] = _showQueueCharts.ToString(),
            ["ShowMissingCharts"] = _showMissingCharts.ToString(),
            ["ShowPosterImages"] = _showPosterImages.ToString(),
            ["DefaultQueueGrouping"] = _defaultGrouping,
            ["ExpandQueueGroupsByDefault"] = _expandGroups.ToString(),
            ["QueueRefreshIntervalSeconds"] = _queueRefreshInterval.ToString()
        });
        LoadValues();
    }

    private Task DiscardAsync()
    {
        _dateFormat = _origDateFormat;
        _useTimeAgo = _origUseTimeAgo;
        _timeAgoThreshold = _origTimeAgoThreshold;
        _queuePageSize = _origQueuePageSize;
        _missingPageSize = _origMissingPageSize;
        _historyPageSize = _origHistoryPageSize;
        _eventsPageSize = _origEventsPageSize;
        _tableDensity = _origTableDensity;
        _showQueueCharts = _origShowQueueCharts;
        _showMissingCharts = _origShowMissingCharts;
        _showPosterImages = _origShowPosterImages;
        _defaultGrouping = _origDefaultGrouping;
        _expandGroups = _origExpandGroups;
        _queueRefreshInterval = _origQueueRefreshInterval;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
