@page "/settings/health"
@using global::System.Globalization
@using Trackarr.Core.Health
@using Trackarr.Core.UI
@using Trackarr.Services.Settings
@layout SettingsLayout
@inject SettingsService SettingsService

<div class="d-flex align-items-center justify-content-between mb-1">
    <h2 class="mb-0">Health Scoring</h2>
    <button class="btn btn-sm btn-app-ghost" @onclick="ResetToDefaults">
        <i class="bi bi-arrow-counterclockwise me-1"></i>
        Reset Defaults
    </button>
</div>
<p class="text-muted mb-4">Configure how download health is scored and when items are eligible for removal.</p>

<h3 class="card-title">Score Bounds</h3>
<div class="row g-3 mb-4">
    <div class="col-4 col-lg-2">
        <label class="form-label" data-bs-toggle="tooltip" title="Score assigned to newly added downloads">
            Starting
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.StartingScore" @bind:after="MarkDirty"/>
    </div>
    <div class="col-4 col-lg-2">
        <label class="form-label" data-bs-toggle="tooltip" title="Highest possible score a download can reach">
            Maximum
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.MaximumScore" @bind:after="MarkDirty"/>
    </div>
    <div class="col-4 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Scores below this value are clamped for display purposes">
            Min Visible
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.MinimumVisibleScore" @bind:after="MarkDirty"/>
    </div>
</div>

<h3 class="card-title">Removal Thresholds</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Minimum confidence percentage before a download is considered for removal">
            Confidence
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.RemovalConfidenceThreshold" @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Minutes after a download is first seen before it becomes eligible for removal">
            Grace Period
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   @bind="_policy.StartupGracePeriodMinutes"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">min</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Number of consecutive bad scans required before removal is triggered">
            Min Bad Scans
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.MinimumBadScansBeforeRemoval" @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Number of recent observations used for rolling analysis">
            Window Size
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.RollingWindowSize" @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="How many scans within the rolling window must be bad to flag the download">
            Bad in Window
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.RequiredBadScansInWindow" @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Number of recent good scans that protect a download from removal after recovery">
            Recovery Prot.
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   @bind="_policy.RecentRecoveryProtectionScans"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">scans</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Maximum bonus points awarded when a download recovers from a bad state">
            Recovery Max
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number" class="form-control" @bind="_policy.RecoveryCreditMax" @bind:after="MarkDirty"/>
    </div>
</div>

<h3 class="card-title">Streak Multipliers</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Multiplier applied to penalties for each consecutive bad scan">
            Penalty Escalation
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               step="0.1"
               class="form-control"
               style="max-width: 6rem;"
               @bind="_policy.PenaltyStreakEscalation"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Maximum penalty multiplier — streaks won't escalate beyond this">
            Penalty Cap
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               step="0.1"
               class="form-control"
               style="max-width: 6rem;"
               @bind="_policy.PenaltyStreakCap"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Multiplier applied to rewards for each consecutive good scan">
            Reward Escalation
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               step="0.1"
               class="form-control"
               style="max-width: 6rem;"
               @bind="_policy.RewardStreakEscalation"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Maximum reward multiplier — streaks won't escalate beyond this">
            Reward Cap
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               step="0.1"
               class="form-control"
               style="max-width: 6rem;"
               @bind="_policy.RewardStreakCap"
               @bind:after="MarkDirty"/>
    </div>
</div>

<h3 class="card-title">State Thresholds</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Score at or above this value is considered healthy">
            <span class="badge bg-success-lt text-success me-1">Healthy</span> &ge;
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               class="form-control"
               style="max-width: 5rem;"
               @bind="_policy.HealthyThreshold"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Score at or above this value is considered stable">
            <span class="badge bg-blue-lt text-blue me-1">Stable</span> &ge;
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               class="form-control"
               style="max-width: 5rem;"
               @bind="_policy.StableThreshold"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Score at or above this value is in the watching state — not yet critical">
            <span class="badge bg-warning-lt text-warning me-1">Watching</span> &ge;
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               class="form-control"
               style="max-width: 5rem;"
               @bind="_policy.WatchingThreshold"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Score at or above this value is degrading — approaching removal territory">
            <span class="badge bg-danger-lt text-danger me-1">Degrading</span> &ge;
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               class="form-control"
               style="max-width: 5rem;"
               @bind="_policy.DegradingThreshold"
               @bind:after="MarkDirty"/>
    </div>
</div>

<h3 class="card-title">Rewards</h3>
<p class="text-muted mb-2">Points added when positive events are observed.</p>
<div class="row g-2 mb-4">
    @foreach (var r in _rewards)
    {
        <div class="col-4 col-lg-2">
            <label class="form-label small" data-bs-toggle="tooltip" title="@r.Tooltip">
                @r.Label
                <i class="ti ti-info-circle ms-1 opacity-50"></i>
            </label>
            <input type="number"
                   class="form-control"
                   value="@r.Get()"
                   @onchange="e => { r.Set(int.TryParse(e.Value?.ToString(), out var v) ? v : r.Get()); MarkDirty(); }"/>
        </div>
    }
</div>

<h3 class="card-title">Penalties</h3>
<p class="text-muted mb-2">Points deducted when negative events are observed. Use negative values.</p>
<div class="row g-2 mb-4">
    @foreach (var p in _penalties)
    {
        <div class="col-4 col-lg-2">
            <label class="form-label small" data-bs-toggle="tooltip" title="@p.Tooltip">
                @p.Label
                <i class="ti ti-info-circle ms-1 opacity-50"></i>
            </label>
            @if (p.IsDecimal)
            {
                <input type="number"
                       step="0.1"
                       class="form-control"
                       value="@p.GetDecimal!()"
                       @onchange="e => { p.SetDecimal!(decimal.TryParse(e.Value?.ToString(), out var v) ? v : p.GetDecimal!()); MarkDirty(); }"/>
            }
            else if (p.Suffix is not null)
            {
                <div class="input-group">
                    <input type="number"
                           class="form-control"
                           value="@p.Get()"
                           @onchange="e => { p.Set(int.TryParse(e.Value?.ToString(), out var v) ? v : p.Get()); MarkDirty(); }"/>
                    <span class="input-group-text">@p.Suffix</span>
                </div>
            }
            else
            {
                <input type="number"
                       class="form-control"
                       value="@p.Get()"
                       @onchange="e => { p.Set(int.TryParse(e.Value?.ToString(), out var v) ? v : p.Get()); MarkDirty(); }"/>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] private SettingsPageContext Context { get; set; } = null!;

    private HealthPolicy _policy = new();
    private HealthPolicy _origPolicy = new();

    private record FieldDef(string Label, string Tooltip, Func<int> Get, Action<int> Set, Func<decimal>? GetDecimal = null, Action<decimal>? SetDecimal = null, string? Suffix = null)
    {
        public bool IsDecimal => GetDecimal is not null;
    }

    private FieldDef[] _rewards = [];
    private FieldDef[] _penalties = [];

    protected override void OnInitialized()
    {
        LoadValues();
        BuildFieldDefs();
        Context.SaveAsync = SaveAsync;
        Context.DiscardAsync = DiscardAsync;
    }

    private void BuildFieldDefs()
    {
        _rewards =
        [
                new FieldDef("Progress", "Points awarded when download progress percentage increases", () => _policy.ProgressIncreaseReward, v => _policy.ProgressIncreaseReward = v),
                new FieldDef("Size Left", "Points awarded when remaining download size decreases", () => _policy.SizeLeftDecreaseReward, v => _policy.SizeLeftDecreaseReward = v),
                new FieldDef("Speed", "Points awarded when download speed is positive and active", () => _policy.SpeedPositiveReward, v => _policy.SpeedPositiveReward = v),
                new FieldDef("ETA", "Points awarded when estimated completion time improves", () => _policy.EtaImprovedReward, v => _policy.EtaImprovedReward = v),
                new FieldDef("Error Clear", "Points awarded when a previous error state is cleared", () => _policy.ErrorClearedReward, v => _policy.ErrorClearedReward = v),
                new FieldDef("Recovery", "Points awarded when a download recovers from a degraded state", () => _policy.RecoveryReward, v => _policy.RecoveryReward = v),
                new FieldDef("Sustained", "Points awarded for maintaining consistent download progress", () => _policy.SustainedProgressReward, v => _policy.SustainedProgressReward = v)
        ];
        _penalties =
        [
                new FieldDef("No Progress", "Penalty when download shows no progress between scans", () => _policy.NoProgressPenalty, v => _policy.NoProgressPenalty = v),
                new FieldDef("Warning", "Penalty when the download client reports a warning state", () => _policy.WarningPenalty, v => _policy.WarningPenalty = v),
                new FieldDef("Error", "Penalty when the download client reports an error state", () => _policy.ErrorPenalty, v => _policy.ErrorPenalty = v),
                new FieldDef("Stalled", "Penalty when the download is stalled with active connections", () => _policy.StalledPenalty, v => _policy.StalledPenalty = v),
                new FieldDef("No Conns", "Penalty when the download is stalled with zero connections", () => _policy.StalledNoConnectionsPenalty, v => _policy.StalledNoConnectionsPenalty = v),
                new FieldDef("Repeat Error", "Additional penalty for repeated consecutive errors", () => _policy.RepeatedErrorPenalty, v => _policy.RepeatedErrorPenalty = v),
                new FieldDef("Media Fail", "Penalty applied when this media item has failed downloads previously", () => _policy.PreviousMediaFailurePenalty, v => _policy.PreviousMediaFailurePenalty = v),
                new FieldDef("Downgraded", "Penalty when quality was already downgraded but download is still failing", () => _policy.QualityDowngradedStillFailingPenalty, v => _policy.QualityDowngradedStillFailingPenalty = v),
                new FieldDef("Fetching", "Penalty applied while the download client is still fetching metadata", () => 0, _ => { }, () => _policy.FetchingMetadataPenalty, v => _policy.FetchingMetadataPenalty = v),
                new FieldDef("Byte Prot.", "Minutes of byte-level progress that protect a download from no-progress penalties", () => _policy.ByteProgressProtectionMinutes, v => _policy.ByteProgressProtectionMinutes = v, Suffix: "min"),
                new FieldDef("Bad Decay", "How many bad scan counts are removed per good observation", () => _policy.GoodObservationBadScanDecay, v => _policy.GoodObservationBadScanDecay = v)
        ];
    }

    private void LoadValues()
    {
        _policy = SettingsService.GetHealthPolicy();
        _origPolicy = SettingsService.GetHealthPolicy();
    }

    private void MarkDirty()
    {
        Context.HasChanges = !PolicyEquals(_policy, _origPolicy);
        Context.NotifyChanged();
    }

    private void ResetToDefaults()
    {
        _policy = new HealthPolicy();
        MarkDirty();
    }

    private async Task SaveAsync()
    {
        await SettingsService.SaveCategoryAsync("HealthPolicy", new Dictionary<string, string>
        {
            ["StartingScore"] = _policy.StartingScore.ToString(),
            ["MaximumScore"] = _policy.MaximumScore.ToString(),
            ["MinimumVisibleScore"] = _policy.MinimumVisibleScore.ToString(),
            ["RemovalConfidenceThreshold"] = _policy.RemovalConfidenceThreshold.ToString(),
            ["StartupGracePeriodMinutes"] = _policy.StartupGracePeriodMinutes.ToString(),
            ["MinimumBadScansBeforeRemoval"] = _policy.MinimumBadScansBeforeRemoval.ToString(),
            ["RollingWindowSize"] = _policy.RollingWindowSize.ToString(),
            ["RequiredBadScansInWindow"] = _policy.RequiredBadScansInWindow.ToString(),
            ["RecentRecoveryProtectionScans"] = _policy.RecentRecoveryProtectionScans.ToString(),
            ["RecoveryCreditMax"] = _policy.RecoveryCreditMax.ToString(),
            ["PenaltyStreakEscalation"] = _policy.PenaltyStreakEscalation.ToString(CultureInfo.CurrentCulture),
            ["PenaltyStreakCap"] = _policy.PenaltyStreakCap.ToString(CultureInfo.CurrentCulture),
            ["RewardStreakEscalation"] = _policy.RewardStreakEscalation.ToString(CultureInfo.CurrentCulture),
            ["RewardStreakCap"] = _policy.RewardStreakCap.ToString(CultureInfo.CurrentCulture),
            ["HealthyThreshold"] = _policy.HealthyThreshold.ToString(),
            ["StableThreshold"] = _policy.StableThreshold.ToString(),
            ["WatchingThreshold"] = _policy.WatchingThreshold.ToString(),
            ["DegradingThreshold"] = _policy.DegradingThreshold.ToString(),
            ["ProgressIncreaseReward"] = _policy.ProgressIncreaseReward.ToString(),
            ["SizeLeftDecreaseReward"] = _policy.SizeLeftDecreaseReward.ToString(),
            ["SpeedPositiveReward"] = _policy.SpeedPositiveReward.ToString(),
            ["EtaImprovedReward"] = _policy.EtaImprovedReward.ToString(),
            ["ErrorClearedReward"] = _policy.ErrorClearedReward.ToString(),
            ["RecoveryReward"] = _policy.RecoveryReward.ToString(),
            ["SustainedProgressReward"] = _policy.SustainedProgressReward.ToString(),
            ["NoProgressPenalty"] = _policy.NoProgressPenalty.ToString(),
            ["WarningPenalty"] = _policy.WarningPenalty.ToString(),
            ["ErrorPenalty"] = _policy.ErrorPenalty.ToString(),
            ["StalledPenalty"] = _policy.StalledPenalty.ToString(),
            ["StalledNoConnectionsPenalty"] = _policy.StalledNoConnectionsPenalty.ToString(),
            ["RepeatedErrorPenalty"] = _policy.RepeatedErrorPenalty.ToString(),
            ["PreviousMediaFailurePenalty"] = _policy.PreviousMediaFailurePenalty.ToString(),
            ["QualityDowngradedStillFailingPenalty"] = _policy.QualityDowngradedStillFailingPenalty.ToString(),
            ["ByteProgressProtectionMinutes"] = _policy.ByteProgressProtectionMinutes.ToString(),
            ["FetchingMetadataPenalty"] = _policy.FetchingMetadataPenalty.ToString(CultureInfo.CurrentCulture),
            ["GoodObservationBadScanDecay"] = _policy.GoodObservationBadScanDecay.ToString()
        });
        LoadValues();
    }

    private Task DiscardAsync()
    {
        _policy = SettingsService.GetHealthPolicy();
        _origPolicy = SettingsService.GetHealthPolicy();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static bool PolicyEquals(HealthPolicy a, HealthPolicy b)
    {
        return a.StartingScore == b.StartingScore && a.MaximumScore == b.MaximumScore && a.MinimumVisibleScore == b.MinimumVisibleScore && a.RemovalConfidenceThreshold == b.RemovalConfidenceThreshold && a.StartupGracePeriodMinutes == b.StartupGracePeriodMinutes && a.MinimumBadScansBeforeRemoval == b.MinimumBadScansBeforeRemoval && a.RollingWindowSize == b.RollingWindowSize && a.RequiredBadScansInWindow == b.RequiredBadScansInWindow && a.RecentRecoveryProtectionScans == b.RecentRecoveryProtectionScans && a.RecoveryCreditMax == b.RecoveryCreditMax && a.PenaltyStreakEscalation == b.PenaltyStreakEscalation && a.PenaltyStreakCap == b.PenaltyStreakCap && a.RewardStreakEscalation == b.RewardStreakEscalation && a.RewardStreakCap == b.RewardStreakCap && a.HealthyThreshold == b.HealthyThreshold && a.StableThreshold == b.StableThreshold && a.WatchingThreshold == b.WatchingThreshold && a.DegradingThreshold == b.DegradingThreshold && a.ProgressIncreaseReward == b.ProgressIncreaseReward && a.SizeLeftDecreaseReward == b.SizeLeftDecreaseReward && a.SpeedPositiveReward == b.SpeedPositiveReward && a.EtaImprovedReward == b.EtaImprovedReward && a.ErrorClearedReward == b.ErrorClearedReward && a.RecoveryReward == b.RecoveryReward && a.SustainedProgressReward == b.SustainedProgressReward && a.NoProgressPenalty == b.NoProgressPenalty && a.WarningPenalty == b.WarningPenalty && a.ErrorPenalty == b.ErrorPenalty && a.StalledPenalty == b.StalledPenalty && a.StalledNoConnectionsPenalty == b.StalledNoConnectionsPenalty && a.RepeatedErrorPenalty == b.RepeatedErrorPenalty && a.PreviousMediaFailurePenalty == b.PreviousMediaFailurePenalty && a.QualityDowngradedStillFailingPenalty == b.QualityDowngradedStillFailingPenalty && a.ByteProgressProtectionMinutes == b.ByteProgressProtectionMinutes && a.FetchingMetadataPenalty == b.FetchingMetadataPenalty && a.GoodObservationBadScanDecay == b.GoodObservationBadScanDecay;
    }

}
