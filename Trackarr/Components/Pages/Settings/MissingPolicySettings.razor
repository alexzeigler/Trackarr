@page "/settings/missing"
@using Trackarr.Core.UI
@using Trackarr.Services.Settings
@layout SettingsLayout
@inject SettingsService SettingsService

<h2 class="mb-1">Missing Media</h2>
<p class="text-muted mb-4">Configure how Trackarr searches for missing media on your servers.</p>

<h3 class="settings-section-title">Search Behavior</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Wait after the first search before trying again. Doubles after each failed search (up to 7 days) so hard-to-find items don't hammer your indexers">
            Search Cooldown
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="1"
                   max="168"
                   @bind="_cooldownHours"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">hours</span>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Most items searched per server in one run. The rest wait for a later run">
            Searches Per Run
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="1"
                   max="500"
                   @bind="_maxPerRun"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">items</span>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Number of failed searches before falling back to the server's fallback quality profile, if one is set">
            Max Failed Searches
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <input type="number"
               class="form-control"
               min="1"
               max="50"
               @bind="_maxFailed"
               @bind:after="MarkDirty"/>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Series with up to this many missing episodes switch to per-episode searches after failing. Larger gaps keep using one series search">
            Episode Cascade
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="1"
                   max="50"
                   @bind="_maxCascade"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">episodes</span>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip" title="Failed searches before Trackarr stops searching for an item">
            Abandon After
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number" class="form-control" min="1" max="100" @bind="_abandonAfter" @bind:after="MarkDirty"/>
            <span class="input-group-text">fails</span>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Abandoned items get a fresh round of searches after this many days, in case a release has shown up. 0 keeps them abandoned">
            Retry Abandoned After
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number" class="form-control" min="0" max="365" @bind="_retryDays" @bind:after="MarkDirty"/>
            <span class="input-group-text">days</span>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private SettingsPageContext Context { get; set; } = null!;

    private int _cooldownHours;
    private int _maxPerRun;
    private int _maxFailed;
    private int _maxCascade;
    private int _abandonAfter;
    private int _retryDays;

    private int _origCooldownHours;
    private int _origMaxPerRun;
    private int _origMaxFailed;
    private int _origMaxCascade;
    private int _origAbandonAfter;
    private int _origRetryDays;

    protected override void OnInitialized()
    {
        LoadValues();
        Context.SaveAsync = SaveAsync;
        Context.DiscardAsync = DiscardAsync;
        Context.NotifyChanged();
    }

    private void LoadValues()
    {
        _cooldownHours = SettingsService.GetInt("MissingPolicy", "SearchCooldownHours", 6);
        _maxPerRun = SettingsService.GetInt("MissingPolicy", "MaxSearchesPerRun", 10);
        _maxFailed = SettingsService.GetInt("MissingPolicy", "MaxFailedSearches", 3);
        _maxCascade = SettingsService.GetInt("MissingPolicy", "MaxEpisodeCascade", 3);
        _abandonAfter = SettingsService.GetInt("MissingPolicy", "AbandonAfter", 5);
        _retryDays = SettingsService.GetInt("MissingPolicy", "RetryAbandonedAfterDays", 30);

        _origCooldownHours = _cooldownHours;
        _origMaxPerRun = _maxPerRun;
        _origMaxFailed = _maxFailed;
        _origMaxCascade = _maxCascade;
        _origAbandonAfter = _abandonAfter;
        _origRetryDays = _retryDays;
    }

    private void MarkDirty()
    {
        Context.HasChanges = _cooldownHours != _origCooldownHours || _maxPerRun != _origMaxPerRun ||
                             _maxFailed != _origMaxFailed || _maxCascade != _origMaxCascade ||
                             _abandonAfter != _origAbandonAfter || _retryDays != _origRetryDays;
        Context.NotifyChanged();
    }

    private async Task SaveAsync()
    {
        await SettingsService.SaveCategoryAsync("MissingPolicy", new Dictionary<string, string>
        {
            ["SearchCooldownHours"] = _cooldownHours.ToString(),
            ["MaxSearchesPerRun"] = _maxPerRun.ToString(),
            ["MaxFailedSearches"] = _maxFailed.ToString(),
            ["MaxEpisodeCascade"] = _maxCascade.ToString(),
            ["AbandonAfter"] = _abandonAfter.ToString(),
            ["RetryAbandonedAfterDays"] = _retryDays.ToString()
        });
        LoadValues();
    }

    private Task DiscardAsync()
    {
        _cooldownHours = _origCooldownHours;
        _maxPerRun = _origMaxPerRun;
        _maxFailed = _origMaxFailed;
        _maxCascade = _origMaxCascade;
        _abandonAfter = _origAbandonAfter;
        _retryDays = _origRetryDays;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
