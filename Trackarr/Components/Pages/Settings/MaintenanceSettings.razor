@page "/settings/maintenance"
@using Trackarr.Core.UI
@using Trackarr.Services.Routines
@using Trackarr.Services.Settings
@layout SettingsLayout
@inject SettingsService SettingsService
@inject RoutineRunner RoutineRunner

<h2 class="mb-1">Maintenance</h2>
<p class="text-muted mb-4">Data retention and database cleanup configuration.</p>

<h3 class="settings-section-title">Retention Periods</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="Health events older than this are pruned for non-active downloads">
            Health Events
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="7"
                   max="365"
                   @bind="_healthRetention"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">days</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Routine execution history older than this is deleted">
            Routine Runs
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="7"
                   max="365"
                   @bind="_routineRetention"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">days</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label" data-bs-toggle="tooltip" title="Application log events older than this are deleted">
            Log Events
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number" class="form-control" min="1" max="365" @bind="_logRetention" @bind:after="MarkDirty"/>
            <span class="input-group-text">days</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip" title="Source reputation summaries not seen in this many days are purged">
            Source Summaries
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="7"
                   max="365"
                   @bind="_summaryRetention"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">days</span>
        </div>
    </div>
</div>

<hr class="settings-divider"/>
<h3 class="settings-section-title">Cleanup Behavior</h3>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <label class="form-label"
               data-bs-toggle="tooltip"
               title="How often the automatic database cleanup routine runs">
            Cleanup Interval
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <div class="input-group">
            <input type="number"
                   class="form-control"
                   min="1"
                   max="168"
                   @bind="_cleanupInterval"
                   @bind:after="MarkDirty"/>
            <span class="input-group-text">hrs</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <label class="form-label d-block"
               data-bs-toggle="tooltip"
               title="Run SQLite VACUUM after cleanup to reclaim disk space — may briefly lock the database">
            Post-Cleanup
            <i class="ti ti-info-circle ms-1 opacity-50"></i>
        </label>
        <label class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" @bind="_vacuumAfter" @bind:after="MarkDirty"/>
            <span class="form-check-label">Vacuum after cleanup</span>
        </label>
    </div>
</div>

<hr class="settings-divider"/>
<h3 class="settings-section-title">Manual Actions</h3>
<div class="d-flex align-items-center gap-3 mb-4">
    <button class="btn btn-app-ghost" disabled="@_runningCleanup" @onclick="RunCleanupNow">
        @if (_runningCleanup)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        else
        {
            <i class="ti ti-trash me-1"></i>
        }
        Run Cleanup Now
    </button>
    @if (_cleanupResult is not null)
    {
        <span class="text-muted small">@_cleanupResult</span>
    }
</div>

@code {
    [CascadingParameter] private SettingsPageContext Context { get; set; } = null!;

    private int _healthRetention;
    private int _routineRetention;
    private int _logRetention;
    private int _summaryRetention;
    private bool _vacuumAfter;
    private int _cleanupInterval;

    private int _origHealthRetention;
    private int _origRoutineRetention;
    private int _origLogRetention;
    private int _origSummaryRetention;
    private bool _origVacuumAfter;
    private int _origCleanupInterval;

    private bool _runningCleanup;
    private string? _cleanupResult;

    protected override void OnInitialized()
    {
        LoadValues();
        Context.SaveAsync = SaveAsync;
        Context.DiscardAsync = DiscardAsync;
        Context.NotifyChanged();
    }

    private void LoadValues()
    {
        _healthRetention = SettingsService.GetInt("Maintenance", "HealthEventRetentionDays", 90);
        _routineRetention = SettingsService.GetInt("Maintenance", "RoutineRunRetentionDays", 30);
        _logRetention = SettingsService.GetInt("Maintenance", "LogEventRetentionDays", 14);
        _summaryRetention = SettingsService.GetInt("Maintenance", "SourceSummaryRetentionDays", 90);
        _vacuumAfter = SettingsService.GetBool("Maintenance", "VacuumAfterCleanup", true);
        _cleanupInterval = SettingsService.GetInt("Maintenance", "CleanupIntervalHours", 24);

        _origHealthRetention = _healthRetention;
        _origRoutineRetention = _routineRetention;
        _origLogRetention = _logRetention;
        _origSummaryRetention = _summaryRetention;
        _origVacuumAfter = _vacuumAfter;
        _origCleanupInterval = _cleanupInterval;
    }

    private void MarkDirty()
    {
        Context.HasChanges = _healthRetention != _origHealthRetention || _routineRetention != _origRoutineRetention || _logRetention != _origLogRetention || _summaryRetention != _origSummaryRetention || _vacuumAfter != _origVacuumAfter || _cleanupInterval != _origCleanupInterval;
        Context.NotifyChanged();
    }

    private async Task SaveAsync()
    {
        await SettingsService.SaveCategoryAsync("Maintenance", new Dictionary<string, string>
        {
            ["HealthEventRetentionDays"] = _healthRetention.ToString(),
            ["RoutineRunRetentionDays"] = _routineRetention.ToString(),
            ["LogEventRetentionDays"] = _logRetention.ToString(),
            ["SourceSummaryRetentionDays"] = _summaryRetention.ToString(),
            ["VacuumAfterCleanup"] = _vacuumAfter.ToString(),
            ["CleanupIntervalHours"] = _cleanupInterval.ToString()
        });
        await ApplyCleanupIntervalAsync();
        LoadValues();
    }

    // The routine definition holds the live interval; update it now so the change applies without a restart.
    private async Task ApplyCleanupIntervalAsync()
    {
        await RoutineRunner.SetIntervalAsync("database-cleanup", Math.Max(1, _cleanupInterval) * 3600);
    }

    private Task DiscardAsync()
    {
        _healthRetention = _origHealthRetention;
        _routineRetention = _origRoutineRetention;
        _logRetention = _origLogRetention;
        _summaryRetention = _origSummaryRetention;
        _vacuumAfter = _origVacuumAfter;
        _cleanupInterval = _origCleanupInterval;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RunCleanupNow()
    {
        _runningCleanup = true;
        _cleanupResult = null;
        StateHasChanged();

        try
        {
            RoutineRunner.RunAsync("database-cleanup");
            await Task.Delay(500);
            _cleanupResult = "Cleanup triggered successfully.";
        }
        catch (Exception ex)
        {
            _cleanupResult = $"Failed: {ex.Message}";
        }
        finally
        {
            _runningCleanup = false;
        }
    }
}
