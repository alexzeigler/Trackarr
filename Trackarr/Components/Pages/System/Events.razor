@page "/system/events"
@using Trackarr.Services.Diagnostics
@using static Utils
@inject EventService EventService
@inject ILogger<Events> Logger

<PageTitle>Logs</PageTitle>

<div class="page-body">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="page-title mb-1">Logs</h2>
            <div class="text-muted small">System events and application diagnostics</div>
        </div>

        <div class="btn-list">
            <button type="button" class="btn btn-outline-secondary" disabled="@_isRefreshing" @onclick="LoadLogsAsync">
                @if (_isRefreshing)
                {
                    <i class="ti ti-refresh spinner me-2"></i>
                    <span>Refreshing</span>
                }
                else
                {
                    <i class="ti ti-refresh me-2"></i>
                    <span>Refresh</span>
                }
            </button>

            <button type="button" class="btn btn-outline-danger" disabled="@_isRefreshing" @onclick="DeleteAllLogs">
                <i class="ti ti-trash me-2"></i> Clear
            </button>
        </div>
    </div>

    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card app-card">
                <div class="card-body">
                    <div class="text-muted small">Total Logs</div>
                    <div class="h2 mb-0">@_logs.Count</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card app-card">
                <div class="card-body">
                    <div class="text-muted small">Warnings</div>
                    <div class="h2 mb-0">@WarningCount</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card app-card">
                <div class="card-body">
                    <div class="text-muted small">Errors</div>
                    <div class="h2 mb-0">@ErrorCount</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card app-card">
                <div class="card-body">
                    <div class="text-muted small">Last 15 Minutes</div>
                    <div class="h2 mb-0">@RecentCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card app-card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Events</h3>
                <div class="text-muted small">Showing @PageStart - @PageEnd of @FilteredLogs.Count</div>
            </div>

            <div class="ms-auto d-flex flex-wrap gap-2">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input class="form-control" placeholder="Filter logs..." @bind="FilterText" @bind:event="oninput"/>
                </div>

                <select class="form-select w-auto" @bind="SelectedLevel">
                    <option value="">All Levels</option>
                    <option value="@LogLevel.Trace">Trace</option>
                    <option value="@LogLevel.Debug">Debug</option>
                    <option value="@LogLevel.Information">Information</option>
                    <option value="@LogLevel.Warning">Warning</option>
                    <option value="@LogLevel.Error">Error</option>
                    <option value="@LogLevel.Critical">Critical</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter table-nowrap card-table">
                <thead>
                <tr>
                    <th class="w-1"></th>
                    <th>
                        <button type="button"
                                class="table-sort border-0 bg-transparent p-0 text-reset"
                                @onclick="@(() => SortBy("time"))">
                            Time <i class="@SortIcon("time") ms-1"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="table-sort border-0 bg-transparent p-0 text-reset"
                                @onclick="@(() => SortBy("level"))">
                            Level <i class="@SortIcon("level") ms-1"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="table-sort border-0 bg-transparent p-0 text-reset"
                                @onclick="@(() => SortBy("source"))">
                            Component <i class="@SortIcon("source") ms-1"></i>
                        </button>
                    </th>
                    <th>Message</th>
                    <th class="w-1"></th>
                </tr>
                </thead>

                <tbody>
                @foreach (var log in PagedLogs)
                {
                    <tr>
                        <td>
                            <i class="@LevelIcon(log.LogLevel)" title="@log.LogLevel"></i>
                        </td>

                        <td class="text-muted" title="@log.TimeStamp.ToLocalTime().ToString("f")">
                            @log.TimeStamp.ToLocalTime().ToString("MMM d, h:mm tt").ToLower()
                        </td>

                        <td>
                            <span class="badge @LevelBadgeClass(log.LogLevel)">
                                @log.LogLevel
                            </span>
                        </td>

                        <td class="text-muted">
                            @TextDisplay(log.Source)
                        </td>

                        <td class="text-truncate" title="@log.Message">
                            @TextDisplay(log.Message)
                        </td>

                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#logDetailsModal"
                                    @onclick="() => SelectLog(log)">
                                Details
                            </button>
                        </td>
                    </tr>
                }

                @if (!PagedLogs.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No logs found.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Rows</span>
                <select class="form-select form-select-sm w-auto" @bind="PageSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="250">250</option>
                </select>
            </div>

            <ul class="pagination m-0 ms-auto">
                <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                    <button type="button" class="page-link" @onclick="FirstPage">
                        <i class="ti ti-chevrons-left"></i>
                    </button>
                </li>

                <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                    <button type="button" class="page-link" @onclick="PreviousPage">
                        <i class="ti ti-chevron-left"></i>
                    </button>
                </li>

                <li class="page-item active">
                    <span class="page-link">
                        @_currentPage / @TotalPages
                    </span>
                </li>

                <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                    <button type="button" class="page-link" @onclick="NextPage">
                        <i class="ti ti-chevron-right"></i>
                    </button>
                </li>

                <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                    <button type="button" class="page-link" @onclick="LastPage">
                        <i class="ti ti-chevrons-right"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 class="modal-title">Log Details</h3>
                    @if (_selectedLog is not null)
                    {
                        <div class="text-muted small">
                            @_selectedLog.TimeStamp.ToLocalTime().ToString("f")
                        </div>
                    }
                </div>

                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (_selectedLog is not null)
                {
                    <div class="row row-cards mb-3">
                        <div class="col-md-4">
                            <div class="card app-card">
                                <div class="card-body">
                                    <div class="text-muted small">Level</div>
                                    <span class="badge @LevelBadgeClass(_selectedLog.LogLevel)">
                                        @_selectedLog.LogLevel
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card app-card">
                                <div class="card-body">
                                    <div class="text-muted small">Component</div>
                                    <div>@TextDisplay(_selectedLog.Source)</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card app-card">
                                <div class="card-body">
                                    <div class="text-muted small">Time</div>
                                    <div>@_selectedLog.TimeStamp.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small mb-1">Message</div>
                        <pre class="border font-monospace p-3 rounded small user-select-all mb-0">@_selectedLog.Message</pre>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedLog.Exception))
                    {
                        <div>
                            <div class="text-muted small mb-1">Exception</div>
                            <pre class="border font-monospace p-3 rounded small user-select-all mb-0">@_selectedLog.Exception</pre>
                        </div>
                    }
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>