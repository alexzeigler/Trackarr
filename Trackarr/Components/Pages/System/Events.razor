@page "/system/events"
@using Trackarr.Core.Event
@using Trackarr.Core.UI
@using Trackarr.Services
@inject EventService EventService

<PageTitle>Logs</PageTitle>

<OptionsBanner Options="Options"/>

<div class="p-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="m-0">Logs</h3>
    </div>

    <div class="d-flex gap-2 mb-3">
        <input class="form-control"
               placeholder="Filter logs..."
               @bind="filterText"
               @bind:event="oninput"/>

        <select class="form-select" style="max-width:180px;" @bind="selectedLevel">
            <option value="">All Levels</option>
            <option value="@LogLevel.Trace">Trace</option>
            <option value="@LogLevel.Debug">Debug</option>
            <option value="@LogLevel.Information">Information</option>
            <option value="@LogLevel.Warning">Warning</option>
            <option value="@LogLevel.Error">Error</option>
            <option value="@LogLevel.Critical">Critical</option>
        </select>

    </div>
    <div class="d-flex align-items-center justify-content-between mt-3">
        <div class="text-secondary small">
            Showing @PageStart - @PageEnd of @FilteredLogs.Count
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#pageSizeModal"
                    title="Items per page">
                <i class="bi bi-list-ol"></i>
                @pageSize
            </button>

            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(currentPage <= 1)"
                    @onclick="FirstPage"
                    title="First Page">
                <i class="bi bi-chevron-double-left"></i>
            </button>

            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(currentPage <= 1)"
                    @onclick="PreviousPage"
                    title="Previous Page">
                <i class="bi bi-chevron-left"></i>
            </button>

            <span class="small px-2">
                @currentPage / @TotalPages
            </span>

            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(currentPage >= TotalPages)"
                    @onclick="NextPage"
                    title="Next Page">
                <i class="bi bi-chevron-right"></i>
            </button>

            <button class="btn btn-sm btn-outline-secondary"
                    disabled="@(currentPage >= TotalPages)"
                    @onclick="LastPage"
                    title="Last Page">
                <i class="bi bi-chevron-double-right"></i>
            </button>
        </div>
    </div>


    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 logs-table">
                <thead>
                <tr>
                    <th style="width:40px"></th>
                    <th>Time</th>
                    <th>Component</th>
                    <th>Message</th>
                </tr>
                </thead>

                <tbody>
                @foreach (LogEvent log in PagedLogs) {
                    <tr>
                        <td>
                            @switch (log.LogLevel) {
                                case LogLevel.Trace:
                                case LogLevel.Debug:
                                    <i class="bi bi-bug-fill text-secondary" title="debug"></i>
                                    break;

                                case LogLevel.Information:
                                    <i class="bi bi-info-circle-fill text-info" title="info"></i>
                                    break;

                                case LogLevel.Warning:
                                    <i class="bi bi-exclamation-circle-fill text-warning" title="warning"></i>
                                    break;

                                case LogLevel.Error:
                                case LogLevel.Critical:
                                    <i class="bi bi-x-circle-fill text-danger" title="error"></i>
                                    break;

                                case LogLevel.None:
                                default:
                                    <i class="bi bi-circle-fill text-secondary"></i>
                                    break;
                            }
                        </td>

                        <td title="@log.TimeStamp.ToLocalTime().ToString("f")">
                            @log.TimeStamp.ToLocalTime().ToString("h:mmtt").ToLower()
                        </td>

                        <td>@log.Source</td>

                        <td>@log.Message</td>
                    </tr>
                }

                @if (!PagedLogs.Any()) {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">
                            No logs found.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>


</div>

<div class="modal fade" id="pageSizeModal" tabindex="-1" aria-labelledby="pageSizeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pageSizeModalLabel">Items Per Page</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Show up to 250 logs per page</label>
                <input type="number"
                       class="form-control"
                       min="1"
                       max="250"
                       @bind="pageSizeInput"/>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal"
                        @onclick="ApplyPageSize">
                    Apply
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<LogEvent> logs = [];
    private bool isRefreshing;
    private IReadOnlyList<Option> Options = [];

    private string filterText = string.Empty;
    private string selectedLevel = string.Empty;

    private int currentPage = 1;
    private int pageSize = 50;
    private int pageSizeInput = 50;

    private List<LogEvent> FilteredLogs {
        get {
            IEnumerable<LogEvent> query = logs;

            if (!string.IsNullOrWhiteSpace(selectedLevel) && Enum.TryParse(selectedLevel, out LogLevel level)) {
                query = query.Where(x => x.LogLevel == level);
            }

            if (!string.IsNullOrWhiteSpace(filterText)) {
                query = query.Where(x => x.Source.Contains(filterText, StringComparison.OrdinalIgnoreCase) || x.Message.Contains(filterText, StringComparison.OrdinalIgnoreCase) || x.LogLevel.ToString().Contains(filterText, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private List<LogEvent> PagedLogs => FilteredLogs.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredLogs.Count / (double)pageSize));

    private int PageStart => FilteredLogs.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;

    private int PageEnd => Math.Min(currentPage * pageSize, FilteredLogs.Count);

    protected override async Task OnInitializedAsync() {
        Options = BuildOptions();
        await LoadLogsAsync();
    }

    private IReadOnlyList<Option> BuildOptions() {
        return [
                new Option { DisplayName = "Refresh", Icon = isRefreshing ? "bi-arrow-clockwise spin" : "bi-arrow-clockwise", Command = LoadLogsAsync },
                new Option { DisplayName = "Clear", Icon = "bi-trash-fill", Command = DeleteAllLogs }
        ];
    }

    private async Task LoadLogsAsync() {
        isRefreshing = true;
        Options = BuildOptions();
        await InvokeAsync(StateHasChanged);

        try {
            logs = await EventService.GetAllAsync();
            currentPage = 1;
        }
        finally {
            isRefreshing = false;
            Options = BuildOptions();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteAllLogs() {
        await EventService.ClearAllAsync();
        logs.Clear();
        currentPage = 1;
    }

    private void PreviousPage() {
        if (currentPage > 1) {
            currentPage--;
        }
    }

    private void NextPage() {
        if (currentPage < TotalPages) {
            currentPage++;
        }
    }

    private void ApplyPageSize() {
        pageSize = Math.Clamp(pageSizeInput, 1, 250);
        pageSizeInput = pageSize;
        currentPage = 1;
    }

    private void FirstPage() {
        currentPage = 1;
    }

    private void LastPage() {
        currentPage = TotalPages;
    }

}