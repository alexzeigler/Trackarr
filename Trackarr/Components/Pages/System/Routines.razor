@page "/system/routines"
@using Trackarr.Core.Routine
@using Trackarr.Services.Routines
@using static Utils;
@inject RoutineRunner RoutineRunner

<PageTitle>Routines</PageTitle>

<div class="d-flex flex-column gap-3">
    <div class="card app-card">
        <div class="card-header">
            <div class="d-flex flex-wrap align-items-center gap-2 w-100">
                <div class="ms-auto d-flex flex-wrap btn-list">
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-app-ghost" @onclick="ClearFilters">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon m-0 me-1">
                                <path d="M18 6l-12 12"/>
                                <path d="M6 6l12 12"/>
                            </svg>
                            Clear
                        </button>
                    }

                    <select class="form-select w-auto" value="@_statusFilter" @onchange="OnStatusFilterChanged">
                        <option value="">All Statuses</option>
                        <option value="Running">Running</option>
                        <option value="Queued">Queued</option>
                        <option value="Enabled">Enabled</option>
                        <option value="Paused">Paused</option>
                        <option value="Disabled">Disabled</option>
                        <option value="Failed">Failed</option>
                    </select>

                    <button type="button" class="btn btn-app-primary" @onclick="RunAll">
                        <i class="ti ti-player-play me-1"></i>
                        Run All
                    </button>

                    <div class="input-group input-group-flat w-auto">
                        <span class="input-group-text">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon icon-1">
                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                                <path d="M21 21l-6 -6"></path>
                            </svg>
                        </span>
                        <input type="text"
                               class="form-control form-control-sm"
                               autocomplete="off"
                               placeholder="Search routines..."
                               value="@_search"
                               @oninput="OnSearchChanged"/>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter table-nowrap">
                <thead>
                <tr>
                    <th>
                        <button class="@SortClass("name")" @onclick='() => SortBy("name")'>Routine</button>
                    </th>
                    <th style="width: 100px">
                        <button class="@SortClass("status")" @onclick='() => SortBy("status")'>Status</button>
                    </th>
                    <th style="width: 80px">
                        <button class="@SortClass("interval")" @onclick='() => SortBy("interval")'>Interval</button>
                    </th>
                    <th style="width: 100px" class="text-end">
                        <button class="@SortClass("lastRun")" @onclick='() => SortBy("lastRun")'>Last Run</button>
                    </th>
                    <th style="width: 100px" class="text-end">
                        <button class="@SortClass("nextRun")" @onclick='() => SortBy("nextRun")'>Next Run</button>
                    </th>
                    <th style="width: 90px">
                        <button class="@SortClass("result")" @onclick='() => SortBy("result")'>Result</button>
                    </th>
                    <th class="w-1"></th>
                </tr>
                </thead>
                <tbody class="table-tbody">
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <div class="spinner-border spinner-border-sm me-2"></div>
                            Loading routines
                        </td>
                    </tr>
                }
                else if (!FilteredRoutines.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No routines found</td>
                    </tr>
                }
                else
                {
                    @foreach (var routine in FilteredRoutines)
                    {
                        <tr @key="routine.Key">
                            <td>
                                <div class="fw-semibold">@routine.Name</div>
                                @if (!string.IsNullOrWhiteSpace(routine.Description))
                                {
                                    <div class="text-secondary small">@routine.Description</div>
                                }
                            </td>
                            <td>
                                @{ var queued = RoutineRunner.IsQueued(routine.Key); }
                                <span class="@RoutineStatusBadge(routine, queued)">
                                    @RoutineStatusText(routine, queued)
                                </span>
                            </td>
                            <td>@IntervalText(routine.IntervalSeconds)</td>
                            <td class="text-end text-secondary">@TimeAgo(routine.LastRun)</td>
                            <td class="text-end text-secondary">@TimeAgo(routine.NextRun)</td>
                            <td>
                                <span class="@RoutineResultClass(routine)">
                                    @RoutineResultText(routine)
                                </span>
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    @if (routine.IsRunning)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ForceReset(routine.Key)">
                                            Force Stop
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="btn-list flex-nowrap">
                                            <button type="button"
                                                    class="btn btn-sm btn-app-primary"
                                                    @onclick="() => RunRoutine(routine.Key)">
                                                Run
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm @(routine.IsPaused ? "btn-success" : "btn-warning")"
                                                    @onclick="() => TogglePaused(routine)">
                                                @(routine.IsPaused ? "Resume" : "Pause")
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm @(routine.Enabled ? "btn-danger" : "btn-app-primary")"
                                                    @onclick="() => ToggleEnabled(routine)">
                                                @(routine.Enabled ? "Disable" : "Enable")
                                            </button>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center justify-content-end">
            <div class="fw-semibold">@FilteredRoutines.Count() of @_routines.Count routines</div>
        </div>
    </div>

    <div class="card app-card">
        <div class="card-header">
            <h3 class="card-title">Recent Runs</h3>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter table-nowrap">
                <thead>
                <tr>
                    <th>Routine</th>
                    <th style="width: 100px">Duration</th>
                    <th style="width: 100px" class="text-end">Started</th>
                    <th style="width: 100px" class="text-end">Completed</th>
                    <th style="width: 80px">Status</th>
                    <th>Message</th>
                </tr>
                </thead>
                <tbody class="table-tbody">
                @if (!RecentRuns.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No routine runs found</td>
                    </tr>
                }
                else
                {
                    @foreach (var run in RecentRuns)
                    {
                        <tr @key="run.Id">
                            <td class="fw-semibold">@(_routines.FirstOrDefault(x => x.Id == run.RoutineDefinitionId)?.Name ?? "—")</td>
                            <td>@DurationText(run.StartTime, run.EndTime)</td>
                            <td class="text-end text-secondary">@TimeAgo(run.StartTime)</td>
                            <td class="text-end text-secondary">@TimeAgo(run.EndTime)</td>
                            <td>
                                <span class="badge @(run.State == RoutineState.Success ? "bg-success-lt text-success" : "bg-danger-lt text-danger")">
                                    @(run.State == RoutineState.Success ? "Success" : "Failed")
                                </span>
                            </td>
                            <td class="text-secondary" style="max-width: 520px">
                                @TextDisplay(run.ErrorMessage)
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center justify-content-end">
            <div class="fw-semibold">@RecentRuns.Count() of @_runs.Count runs</div>
        </div>
    </div>
</div>
