@page "/"
@inject MediaServerService MediaServerService
@inject HealthService HealthService
@using Trackarr.Components.Modals
@using Trackarr.Core.Media.Shows
@using Trackarr.Core.Queue
@using Trackarr.Services.Media
@using static Utils
@implements IAsyncDisposable

<div class="d-flex flex-column gap-3">
    <MediaDetailsModal @ref="_detailsModal"/>

    <div class="row g-3 w-100">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="stat-icon stat-icon-danger">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="currentColor"
                             class="icon icon-tabler icons-tabler-filled icon-tabler-exclamation-circle">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M17 3.34a10 10 0 1 1 -15 8.66l.005 -.324a10 10 0 0 1 14.995 -8.336m-5 11.66a1 1 0 0 0 -1 1v.01a1 1 0 0 0 2 0v-.01a1 1 0 0 0 -1 -1m0 -7a1 1 0 0 0 -1 1v4a1 1 0 0 0 2 0v-4a1 1 0 0 0 -1 -1"/>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">Stuck</div>
                        <div class="stat-value">@StuckCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="stat-icon stat-icon-warning">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="currentColor"
                             class="icon icon-tabler icons-tabler-filled icon-tabler-clock">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-5 2.66a1 1 0 0 0 -.993 .883l-.007 .117v5l.009 .131a1 1 0 0 0 .197 .477l.087 .1l3 3l.094 .082a1 1 0 0 0 1.226 0l.094 -.083l.083 -.094a1 1 0 0 0 0 -1.226l-.083 -.094l-2.707 -2.708v-4.585l-.007 -.117a1 1 0 0 0 -.993 -.883z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">Waiting</div>
                        <div class="stat-value">@WaitingCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="stat-icon stat-icon-primary">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="currentColor"
                             class="icon icon-tabler icons-tabler-filled icon-tabler-circle-x">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-6.489 5.8a1 1 0 0 0 -1.218 1.567l1.292 1.293l-1.292 1.293l-.083 .094a1 1 0 0 0 1.497 1.32l1.293 -1.292l1.293 1.292l.094 .083a1 1 0 0 0 1.32 -1.497l-1.292 -1.293l1.292 -1.293l.083 -.094a1 1 0 0 0 -1.497 -1.32l-1.293 1.292l-1.293 -1.292l-.094 -.083z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">Missing</div>
                        <div class="stat-value">0</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="stat-icon stat-icon-purple">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="currentColor"
                             class="icon icon-tabler icons-tabler-filled icon-tabler-stack-2">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M20.894 15.553a1 1 0 0 1 -.447 1.341l-8 4a1 1 0 0 1 -.894 0l-8 -4a1 1 0 0 1 .894 -1.788l7.553 3.774l7.554 -3.775a1 1 0 0 1 1.341 .447m0 -4a1 1 0 0 1 -.447 1.341l-8 4a1 1 0 0 1 -.894 0l-8 -4a1 1 0 0 1 .894 -1.788l7.552 3.775l7.554 -3.775a1 1 0 0 1 1.341 .447m-8.887 -8.552q .056 0 .111 .007l.111 .02l.086 .024l.012 .006l.012 .002l.029 .014l.05 .019l.016 .009l.012 .005l8 4a1 1 0 0 1 0 1.788l-8 4a1 1 0 0 1 -.894 0l-8 -4a1 1 0 0 1 0 -1.788l8 -4l.011 -.005l.018 -.01l.078 -.032l.011 -.002l.013 -.006l.086 -.024l.11 -.02l.056 -.005z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-label">Total in Queue</div>
                        <div class="stat-value">@TotalQueueCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <AppTable TItem="DownloadItem"
              Items="_downloads"
              PageSize="PageSize"
              EmptyColspan="10"
              EmptyText="No downloads in queue"
              DefaultSort="name"
              SearchPredicate="MatchesSearch"
              SortSelectors="QueueSorts">
        <ToolbarTemplate>
            <button class="btn btn-app-ghost" @onclick="RefreshAsync" disabled="@IsRefreshing">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20"
                     height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="icon icon-tabler icon-tabler-refresh m-0 @(IsRefreshing ? "spinner" : "")">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                </svg>
            </button>
        </ToolbarTemplate>

        <HeaderTemplate>
            <tr>
                <AppTableColumn SortKey="name" Width="34%">
                    Name
                </AppTableColumn>

                <AppTableColumn SortKey="profile" Width="120px">
                    Profile
                </AppTableColumn>

                <AppTableColumn SortKey="status" Width="120px">
                    Status
                </AppTableColumn>

                <AppTableColumn SortKey="score" Width="90px">
                    Score
                </AppTableColumn>

                <AppTableColumn SortKey="confidence" Width="110px">
                    Confidence
                </AppTableColumn>

                <AppTableColumn SortKey="progress" Width="180px">
                    Progress
                </AppTableColumn>

                <AppTableColumn SortKey="firstSeen" Width="120px" TextEnd="true">
                    First Seen
                </AppTableColumn>

                <AppTableColumn SortKey="lastProgress" Width="130px" TextEnd="true">
                    Last Progress
                </AppTableColumn>

                <AppTableColumn SortKey="lastEval" Width="130px" TextEnd="true">
                    Last Evaluated
                </AppTableColumn>

                <AppTableColumn Width="135px" TextEnd="true"/>
            </tr>
        </HeaderTemplate>

        <RowTemplate Context="item">
            @{
                var key = GetItemKey(item);
                var snapshot = GetSnapshot(item);
                var summary = GetSummary(item);
                var healthEvent = GetHealthEvent(item);
                var progress = item.DownloadPercent;
                var type = GetMediaType(item);
                var status = GetStatusText(item);
                var statusBadgeClass = StatusBadgeClass(status);
                var movie = GetMovie(item);
                var series = GetSeries(item);
                Episode? episode = null;
                var posterUrl = movie != null ? GetPosterUrl(movie.ImagesJson) : series != null ? GetPosterUrl(series.ImagesJson) : null;
                var title = GetDisplayTitle(item);
                var quality = GetQualityName(item);
            }

            <tr @key="key">
                <td class="border-secondary-subtle border">
                    <div class="item-title-cell">
                        @if (posterUrl != null)
                        {
                            <img src="@posterUrl" class="media-poster media-poster-md" alt=""/>
                        }
                        <div>
                            <div class="item-title">@title</div>
                            <div class="item-meta">
                                <span class="app-badge app-badge-muted">@type</span>
                            </div>
                        </div>
                    </div>
                </td>

                <td class="border-secondary-subtle border">
                    <span class="fw-semibold">@quality</span>
                </td>

                <td class="border-secondary-subtle border">
                    <span class="@statusBadgeClass app-badge">@status</span>
                </td>

                <td class="border-secondary-subtle border">
                    <span class="@GetScoreBadgeClass(snapshot?.VisibleScore) score-badge">@snapshot?.VisibleScore</span>
                </td>

                <td class="border-secondary-subtle border">
                    <span class="fw-semibold">@snapshot?.Confidence</span>
                </td>

                <td class="border-secondary-subtle border">
                    <div class="row align-items-center">
                        <div class="col-12 col-lg-auto">@(progress)%</div>
                        <div class="col">
                            <div class="progress progress-2 app-progress">
                                <div class="progress-bar"
                                     style="width: @(progress)%"
                                     role="progressbar"
                                     aria-valuenow="@progress"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-label="@(progress)% Complete">
                                    <span class="visually-hidden">@(progress)% Complete</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>

                <td class="fw-semibold border-secondary-subtle border">
                    @TimeAgo(summary?.CreatedAt)
                </td>

                <td class="fw-semibold border-secondary-subtle border">
                    @TimeAgo(snapshot?.LastGoodObservationAt)
                </td>

                <td class="fw-semibold border-secondary-subtle border">
                    @TimeAgo(healthEvent?.OccurredAt)
                </td>

                <td class="text-end border-secondary-subtle border">
                    <div class="btn-group">
                        <button class="btn btn-app-ghost text-white"
                                @onclick="() => _detailsModal.Open(item, item.ServerId, movie, series, episode)">
                            View
                        </button>
                        <button data-bs-toggle="dropdown"
                                type="button"
                                class="btn btn-app-ghost dropdown-toggle dropdown-toggle-split text-white"
                                aria-expanded="false"></button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" href="#">Mark As...</a>
                            <a class="dropdown-item text-status-failed" href="#">Remove</a>
                        </div>
                    </div>
                </td>
            </tr>
        </RowTemplate>
    </AppTable>
</div>