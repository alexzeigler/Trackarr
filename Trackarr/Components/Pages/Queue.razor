@page "/"
@inject MediaServerService MediaServerService
@inject HealthService HealthService
@using Trackarr.Components.Modals
@using Trackarr.Core.UI
@using Trackarr.Services.Media
@using static Utils
@implements IAsyncDisposable

@if (!_hasServers)
{
    <NoServersPlaceholder/>
    return;
}

<div class="d-flex flex-column gap-3">
    <MediaDetailsModal @ref="_detailsModal"/>
    <SetScoreModal @ref="_setScoreModal" OnSaved="RefreshAsync"/>

    @if (_loadError != null)
    {
        <div class="alert alert-danger mb-0">@_loadError</div>
    }

    @if (_noticeMessage != null)
    {
        <div class="alert alert-warning alert-dismissible mb-0" role="status">
            @_noticeMessage
            <button type="button"
                    class="btn-close"
                    aria-label="Dismiss"
                    @onclick="() => _noticeMessage = null"></button>
        </div>
    }

    @if (_previewMessage != null)
    {
        <div class="alert alert-info alert-dismissible mb-0" role="status">
            <strong>Preview, not recorded:</strong> @_previewMessage
            <button type="button"
                    class="btn-close"
                    aria-label="Dismiss"
                    @onclick="() => _previewMessage = null"></button>
        </div>
    }

    <div class="subheader mt-2 mb-2">Queue Overview</div>
    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Total in Queue</div>
                    <div class="h1 mb-0">@FormatNumber(_pageData.Stats.TotalInQueue)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="subheader">Active</div>
                        @if (_pageData.Stats.TotalInQueue > 0)
                        {
                            <div class="ms-auto d-flex align-items-center @ActiveTrendDisplay.Class">
                                @FormatPercent(DownloadingPercent)
                                <i class="@ActiveTrendDisplay.Icon ms-1"></i>
                            </div>
                        }
                    </div>
                    <div class="h1 mb-0">@FormatNumber(_pageData.Stats.Downloading)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="subheader">At Risk</div>
                        @if (_pageData.Stats.AtRisk > 0)
                        {
                            <div class="ms-auto d-flex align-items-center @AtRiskTrendDisplay.Class">
                                @FormatPercent(AtRiskPercent)
                                <i class="@AtRiskTrendDisplay.Icon ms-1"></i>
                            </div>
                        }
                    </div>
                    <div class="h1 mb-0">@FormatNumber(_pageData.Stats.AtRisk)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="subheader">Avg. Score</div>
                        @if (_pageData.Stats.TotalInQueue > 0)
                        {
                            <div class="ms-auto d-flex align-items-center @ScoreTrendDisplay.Class">
                                <i class="@ScoreTrendDisplay.Icon"></i>
                            </div>
                        }
                    </div>
                    <div class="h1 mb-0">
                        @if (_pageData.Stats.TotalInQueue > 0)
                        {
                            <span class="@AvgScoreClass">@_pageData.Stats.AvgHealthScore</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Data Remaining</div>
                    <div class="h1 mb-0">@FormatBytes(_pageData.Stats.DataRemaining)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-2">
            <div class="card app-card">
                <div class="card-body">
                    <div class="subheader mb-2">Oldest in Queue</div>
                    <div class="h1 mb-0">@FormatDuration(_pageData.Stats.OldestInQueue)</div>
                </div>
            </div>
        </div>
    </div>

    <ChartsToggle SettingKey="ShowQueueCharts" OnChanged="OnChartsToggled"/>

    @if (Settings.GetBool("Display", "ShowQueueCharts", true))
    {
        <div class="row row-cards mb-3">
            <div class="col-lg-4">
                <div class="card app-card h-100">
                    <div class="card-header">
                        <h3 class="card-title">Activity (Last 24h)</h3>
                    </div>
                    <div class="card-body">
                        <div id="queue-activity-chart" class="chart-lg"></div>
                        <div class="mt-3">
                            @foreach (var s in ActivityLegend)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span class="me-2"
                                          style="display:inline-block;width:16px;height:0;border-top:3px solid @s.Color;border-radius:2px;"></span>
                                    <div class="flex-fill">@s.Label</div>
                                    <div class="text-secondary">@FormatNumber(s.Total)</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card app-card h-100">
                    <div class="card-header">
                        <h3 class="card-title">Status Breakdown</h3>
                    </div>
                    <div class="card-body">
                        <ChartHost Id="queue-status-chart" Class="chart-lg"/>
                        <div class="mt-3">
                            @foreach (var item in _pageData.StatusBreakdown)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge @BreakdownDotClass(item.Label) me-2">&nbsp;</span>
                                    <div class="flex-fill">@item.Label</div>
                                    <div class="text-secondary">@FormatNumber(item.Count) (@FormatPercent(item.Percent))</div>
                                </div>
                            }
                            @if (_pageData.StatusBreakdown.Count == 0)
                            {
                                <div class="empty">
                                    <div class="empty-icon">
                                        <i class="ti ti-chart-pie"></i>
                                    </div>
                                    <p class="empty-title">No queue data</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card app-card h-100">
                    <div class="card-header">
                        <h3 class="card-title">Health Distribution</h3>
                    </div>
                    <div class="card-body">
                        <ChartHost Id="queue-health-chart" Class="chart-lg"/>
                        <div class="mt-3">
                            @foreach (var bucket in _pageData.ScoreDistribution)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge @ScoreBucketDotClass(bucket.Label) me-2">&nbsp;</span>
                                    <div class="flex-fill">@bucket.Label</div>
                                    <div class="text-secondary">@FormatNumber(bucket.Count)</div>
                                </div>
                            }
                            @if (_pageData.ScoreDistribution.Count == 0)
                            {
                                <div class="empty">
                                    <div class="empty-icon">
                                        <i class="ti ti-heartbeat"></i>
                                    </div>
                                    <p class="empty-title">No health data</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card app-card">
        <div class="card-header">
            <div class="d-flex flex-wrap align-items-center gap-2 w-100">


                <div class="ms-auto d-flex flex-wrap btn-list">
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-app-ghost" @onclick="ClearFilters">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon m-0 me-1">
                                <path d="M18 6l-12 12"/>
                                <path d="M6 6l12 12"/>
                            </svg>
                            Clear
                        </button>
                    }
                    <select class="form-select w-auto" @onchange="OnStatusFilterChanged">
                        <option value="" selected="@(_statusFilter == null)">All Statuses</option>
                        @foreach (var status in AvailableStatuses)
                        {
                            <option value="@status" selected="@(_statusFilter == status)">@status</option>
                        }
                    </select>

                    <select class="form-select w-auto" @onchange="OnServerFilterChanged">
                        <option value="" selected="@(_serverFilter == null)">All Servers</option>
                        @foreach (var server in _servers)
                        {
                            <option value="@server.Name"
                                    selected="@(_serverFilter == server.Name)">@server.Name</option>
                        }
                    </select>

                    <select class="form-select w-auto" @onchange="OnTypeFilterChanged">
                        <option value="" selected="@(_typeFilter == null)">All Types</option>
                        @foreach (var type in AvailableTypes)
                        {
                            <option value="@type" selected="@(_typeFilter == type)">@type</option>
                        }
                    </select>


                    <button class="btn btn-app-ghost" @onclick="RefreshAsync" disabled="@IsRefreshing">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="icon icon-tabler icon-tabler-refresh m-0 @(IsRefreshing ? "spinner" : "")">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                            <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                        </svg>
                    </button>

                    <div class="input-group input-group-flat w-auto">
                        <span class="input-group-text">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon icon-1">
                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                                <path d="M21 21l-6 -6"></path>
                            </svg>
                        </span>
                        <input type="text"
                               class="form-control form-control-sm"
                               autocomplete="off"
                               placeholder="Search queue..."
                               value="@_searchTerm"
                               @oninput="OnSearchChanged">
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter @TableDensityClass">
                <thead>
                <tr>
                    <th>
                        <button class="@SortClass("name")" @onclick='() => SortBy("name")'>Name</button>
                    </th>
                    <th style="width: 1%">
                        <button class="@SortClass("status")" @onclick='() => SortBy("status")'>Status</button>
                    </th>
                    <th style="width: 160px">
                        <button class="@SortClass("progress")" @onclick='() => SortBy("progress")'>Progress</button>
                    </th>
                    <th style="width: 1%" class="text-end text-nowrap">
                        <button class="@SortClass("seen")" @onclick='() => SortBy("seen")'>Seen</button>
                    </th>
                    <th style="width: 1%" class="text-end text-nowrap">
                        <button class="@SortClass("evaluated")" @onclick='() => SortBy("evaluated")'>Evaluated</button>
                    </th>
                    <th style="width: 1%"></th>
                </tr>
                </thead>
                <tbody class="table-tbody">
                @if (PagedGroups.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No downloads in queue</td>
                    </tr>
                }
                else
                {
                    @foreach (var group in PagedGroups)
                    {
                        var expanded = IsExpanded(group.Key);
                        var itemCount = group.Items.Count;
                        var groupOldestSeen = GetGroupOldestSeen(group);
                        var groupOldestEvaluated = GetGroupOldestEvaluated(group);
                        var firstItem = group.Items[0];
                        var firstMovie = GetMovie(firstItem);
                        var firstSeries = GetSeries(firstItem);

                        <tr @key="group.Key"
                            class="queue-group-row @(IsServerDisabled(firstItem.ServerId) ? "server-disabled" : "")"
                            style="cursor: pointer;"
                            @onclick="() => ToggleGroup(group.Key)">
                            <td>
                                <div class="item-title-cell">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="16"
                                         height="16"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="icon flex-shrink-0"
                                         style="transition: transform .15s; transform: rotate(@(expanded ? "90" : "0")deg);">
                                        <path d="M9 6l6 6l-6 6"/>
                                    </svg>
                                    @if (ShowServerIcons && group.ServerType != null)
                                    {
                                        <img src="img/@(group.ServerType).svg"
                                             alt="@group.ServerType"
                                             title="@group.ServerName"
                                             width="22"
                                             height="22"
                                             style="object-fit: contain;"/>
                                    }
                                    @if (ShowPosters && group.PosterUrl != null)
                                    {
                                        <img src="@group.PosterUrl" class="media-poster media-poster-md" alt=""/>
                                    }
                                    <div>
                                        <div class="item-title fw-semibold">@group.Title</div>
                                        <div class="item-meta">
                                            @if (ShowMediaTypeBadges)
                                            {
                                                <span class="@MediaTypeBadgeClass(group.MediaType)">@group.MediaType</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(group.Quality))
                                            {
                                                <span class="text-secondary ms-2">@group.Quality</span>
                                            }
                                            @if (itemCount > 1)
                                            {
                                                <span class="text-secondary ms-2">@GetEpisodeSummary(group.Items)</span>
                                            }
                                        </div>
                                        @if (IsComfortable)
                                        {
                                            <div class="item-meta">
                                                @{ var client = GetGroupDownloadClient(group); }
                                                @{ var indexer = GetGroupIndexer(group); }
                                                @{ var totalSize = GetGroupTotalSize(group); }
                                                @if (!string.IsNullOrEmpty(client))
                                                {
                                                    <span class="text-secondary">
                                                        <i class="ti ti-download me-1"></i>@client</span>
                                                }
                                                @if (!string.IsNullOrEmpty(indexer))
                                                {
                                                    <span class="text-secondary ms-2">
                                                        <i class="ti ti-world me-1"></i>@indexer</span>
                                                }
                                                @if (totalSize > 0)
                                                {
                                                    <span class="text-secondary ms-2">
                                                        <i class="ti ti-file me-1"></i>@FormatBytes(totalSize)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="@GetGroupStatusClass(group)">@GetGroupStatusSummary(group)</span>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="flex-fill" style="min-width: 0;">
                                        <div class="progress progress-2 app-progress">
                                            <div class="progress-bar"
                                                 style="width: @(group.AverageProgress)%"
                                                 role="progressbar"></div>
                                        </div>
                                    </div>
                                    <span class="text-secondary text-nowrap">@(group.AverageProgress)%</span>
                                </div>
                            </td>

                            <td class="text-end text-secondary text-nowrap">
                                @TimeAgo(groupOldestSeen)
                            </td>

                            <td class="text-end text-secondary text-nowrap">
                                @TimeAgo(groupOldestEvaluated)
                            </td>

                            <td class="text-end">
                                <div class="dropdown" @onclick:stopPropagation="true">
                                    <button data-bs-toggle="dropdown"
                                            type="button"
                                            class="btn btn-app-ghost btn-sm"
                                            aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             class="icon m-0">
                                            <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                            <path d="M12 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                            <path d="M12 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                        </svg>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <button class="dropdown-item"
                                                @onclick="() => OpenGroupDetails(group, firstItem, firstMovie, firstSeries)">
                                            View Details
                                        </button>
                                        <button class="dropdown-item"
                                                @onclick="() => EvaluateGroupAsync(group)"
                                                title="Shows what a scan would decide now, without recording it">
                                            Evaluate All
                                        </button>
                                        <div class="dropdown-divider"></div>
                                        <button class="dropdown-item text-danger"
                                                @onclick="() => RemoveGroupAsync(group)">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        @if (expanded)
                        {
                            @for (var i = 0; i < group.Items.Count; i++)
                            {
                                var item = group.Items[i];
                                var childKey = $"child_{GetItemKey(item)}_{i}";
                                var snapshot = GetSnapshot(item);
                                var summary = GetSummary(item);
                                var healthEvent = GetHealthEvent(item);
                                var progress = item.DownloadPercent;
                                var status = GetStatusText(item);
                                var movie = GetMovie(item);
                                var series = GetSeries(item);

                                <tr @key="childKey"
                                    class="queue-child-row @(IsServerDisabled(item.ServerId) ? "server-disabled" : "")">
                                    <td>
                                        <div class="d-flex align-items-center" @onclick="() => _detailsModal.Open(item, item.ServerId, movie, series)" style="cursor: pointer; padding-left: 36px; gap: 10px;">
                                            @if (ShowHealthBadges)
                                            {
                                                <span class="@GetScoreBadgeClass(ScoreOf(snapshot))"
                                                      title="@(ScoreOf(snapshot) is null ? "Not scored yet: it hasn't started downloading" : null)">@(ScoreOf(snapshot)?.ToString() ?? "–")</span>
                                            }
                                            <div>
                                                <span class="item-title">@GetChildLabel(item)</span>
                                                @if (IsComfortable)
                                                {
                                                    <div class="item-meta">
                                                        @if (!string.IsNullOrWhiteSpace(item.DownloadClient))
                                                        {
                                                            <span class="text-secondary">
                                                                <i class="ti ti-download me-1"></i>@item.DownloadClient
                                                            </span>
                                                        }
                                                        @if (item.Size > 0)
                                                        {
                                                            <span class="text-secondary ms-2">
                                                                <i class="ti ti-file me-1"></i>@FormatBytes(item.Size)
                                                            </span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.TimeLeft))
                                                        {
                                                            <span class="text-secondary ms-2">
                                                                <i class="ti ti-clock me-1"></i>@item.TimeLeft</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="@StatusBadgeClass(status)">@status</span>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="flex-fill" style="min-width: 0;">
                                                <div class="progress progress-2 app-progress">
                                                    <div class="progress-bar"
                                                         style="width: @(progress)%"
                                                         role="progressbar"></div>
                                                </div>
                                            </div>
                                            <span class="text-secondary text-nowrap">@(progress)%</span>
                                        </div>
                                    </td>

                                    <td class="text-end text-secondary text-nowrap">
                                        @TimeAgo(summary?.CreatedAt)
                                    </td>

                                    <td class="text-end text-secondary text-nowrap">
                                        @TimeAgo(healthEvent?.OccurredAt)
                                    </td>

                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button data-bs-toggle="dropdown"
                                                    type="button"
                                                    class="btn btn-app-ghost btn-sm"
                                                    aria-expanded="false"
                                                    @onclick:stopPropagation="true">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     width="16"
                                                     height="16"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round"
                                                     class="icon m-0">
                                                    <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                                    <path d="M12 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                                    <path d="M12 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                                </svg>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <button class="dropdown-item"
                                                        @onclick="() => OpenSetScore(item, snapshot)">
                                                    Set Score
                                                </button>
                                                <button class="dropdown-item"
                                                        @onclick="() => EvaluateItemAsync(item)"
                                                        title="Shows what a scan would decide now, without recording it">
                                                    Evaluate
                                                </button>
                                                @{ var isProtected = snapshot?.DownloadAttempt?.IsProtected == true; }
                                                <button class="dropdown-item"
                                                        title="@(isProtected ? "Allow Trackarr to remove this download again" : "Never remove this download automatically")"
                                                        @onclick="() => SetProtectedAsync(item, !isProtected)">
                                                    @(isProtected ? "Unprotect" : "Protect")
                                                </button>
                                                <button class="dropdown-item"
                                                        @onclick="() => _detailsModal.Open(item, item.ServerId, movie, series)">
                                                    View Details
                                                </button>
                                                <div class="dropdown-divider"></div>
                                                <button class="dropdown-item text-danger"
                                                        @onclick="() => RemoveItemAsync(item)">
                                                    Remove
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-secondary">Showing @PagedGroups.Count of @Groups.Count groups
                (@_downloads.Count total)</p>
            <ul class="pagination m-0 ms-auto">
                <li class="page-item @(_page <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PrevPage">Prev</button>
                </li>
                <li class="page-item">
                    <span class="page-link">@_page / @TotalPages</span>
                </li>
                <li class="page-item @(_page >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage">Next</button>
                </li>
            </ul>
        </div>
    </div>
</div>
