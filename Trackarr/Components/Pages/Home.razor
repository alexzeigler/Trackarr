@page "/"
@using Trackarr.Core.Queue
@using Trackarr.Core.Server
@using Trackarr.Services
@inject MediaServerService ServerService

<div class="p-3">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="m-0">Queue</h3>

        <span class="badge text-bg-secondary">
            @_downloads.Count Items
        </span>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Client</th>
                    <th>Indexer</th>
                    <th>Added</th>
                    <th>ETA</th>
                    <th>Server</th>
                </tr>
                </thead>

                <tbody>
                @foreach (DownloadItem item in _downloads) {
                    <tr>
                        <td>
                            <div class="fw-semibold">
                                @item.Title
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.ErrorMessage)) {
                                <small class="text-danger">
                                    @item.ErrorMessage
                                </small>
                            }
                        </td>

                        <td>
                            @item.Status
                        </td>

                        <td style="min-width:200px;">
                            <div class="progress" style="height:20px;">
                                <div class="progress-bar"
                                     role="progressbar"
                                     style="width:@($"{item.DownloadPercent}%")">
                                    @item.DownloadPercent%
                                </div>
                            </div>
                        </td>

                        <td>
                            @item.DownloadClient
                        </td>

                        <td>
                            @item.Indexer
                        </td>

                        <td>
                            @(item.Added?.ToLocalTime().ToString("g") ?? "-")
                        </td>

                        <td>
                            @(item.EstimatedCompletionTime?.ToLocalTime().ToString("g") ?? "-")
                        </td>

                        <td>
                            @item.ServerId
                        </td>
                    </tr>
                }

                @if (!_downloads.Any()) {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">
                            No downloads found.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {

    private readonly List<DownloadItem> _downloads = [];
    private readonly List<MediaServer> _servers = [];

    protected override async Task OnInitializedAsync() {
        Task<(bool Success, List<MediaServer> Items)> serversResult = ServerService.GetAllServersAsync();
        if (serversResult.Result.Success)
            _servers.AddRange(serversResult.Result.Items);
        foreach (MediaServer server in _servers) {
            (bool Success, List<DownloadItem> Items, string Message) result = await ServerService.GetQueueAsync(server);
            if (result.Success)
                _downloads.AddRange(result.Items);
        }
    }

}