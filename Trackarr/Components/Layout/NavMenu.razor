@inject NavigationManager Nav
@implements IDisposable


<input type = "checkbox" title = "Navigation menu" class = "navbar-toggler" />

<div class = "nav font-monospace h-auto" onclick = "document.querySelector('.navbar-toggler').click()">
    <nav class = "d-flex flex-column">
        @foreach (NavItem item in NavItems) {
            <div class = "nav-item @(IsActive(item.Prefix) ? "active-group" : "inactive-group") p-0">
                <NavLink class = "nav-link nav-parent pl-5" href = "@item.Href" Match = "@item.Match">
                    <i class = "ti @item.Icon"></i>
                    @item.Label
                </NavLink>
                @if (IsActive(item.Prefix) && item.Children.Any()) {
                    @foreach (NavChild child in item.Children) {
                        <div class = "nav-child">
                            <NavLink class = "nav-link nav-link-child"
                                     href = "@child.Href"
                                     Match = "NavLinkMatch.Prefix">
                                @child.Label
                            </NavLink>
                        </div>
                    }
                }
            </div>
        }
    </nav>
</div>

@code {

    private record NavChild(string Label, string Href);

    private record NavItem(string Label, string Href, string Prefix, string Icon, NavLinkMatch Match, List<NavChild> Children);

    private static readonly List<NavItem> NavItems = [
        new("Track",
        "",
        "/",
        "ti-stack-2",
        NavLinkMatch.All,
        []),
        new("Servers",
        "/servers",
        "/servers",
        "ti-server",
        NavLinkMatch.All,
        []),
        new("Settings",
        "/settings",
        "/settings",
        "bi-gear-fill",
        NavLinkMatch.Prefix,
        [
            new NavChild("General", "/settings/general"),
            new NavChild("Services", "/settings/services")
        ]),
        new("System",
        "/system/status",
        "/system",
        "bi-laptop",
        NavLinkMatch.Prefix,
        [
            new NavChild("Status", "/system/status"),
            new NavChild("Tasks", "/system/tasks"),
            new NavChild("Events", "/system/events")
        ])
    ];

    private bool IsActive(string prefix) => prefix == "/" ? Nav.Uri == Nav.BaseUri || Nav.Uri == Nav.BaseUri.TrimEnd('/') : Nav.Uri.StartsWith(Nav.BaseUri.TrimEnd('/') + prefix, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        StateHasChanged();
    }

    public void Dispose() {
        Nav.LocationChanged -= OnLocationChanged;
    }

}