@using Trackarr.Core.UI
@inherits LayoutComponentBase
@implements IDisposable
@layout MainLayout
@inject NavigationManager Nav
@inject IJSRuntime Js
@rendermode InteractiveServer

<CascadingValue Value="_context">
    <div class="container-xl">
        <div class="card app-card">
            <div class="row g-0">
                <div class="col-12 col-md-3 border-end" style="border-color: rgba(255,255,255,.08) !important;">
                    <div class="card-body">
                        <h4 class="subheader">Application</h4>
                        <div class="list-group list-group-transparent">
                            <a href="/settings/general"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/general")">
                                <i class="ti ti-adjustments-alt me-2 opacity-75"></i>
                                General
                            </a>
                            <a href="/settings/display"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/display")">
                                <i class="ti ti-palette me-2 opacity-75"></i>
                                Display
                            </a>
                            <a href="/settings/services"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/services")">
                                <i class="ti ti-server me-2 opacity-75"></i>
                                Servers
                            </a>
                        </div>

                        <h4 class="subheader mt-4">Policies</h4>
                        <div class="list-group list-group-transparent">
                            <a href="/settings/health"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/health")">
                                <i class="ti ti-heartbeat me-2 opacity-75"></i>
                                Health Scoring
                            </a>
                            <a href="/settings/missing"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/missing")">
                                <i class="ti ti-search me-2 opacity-75"></i>
                                Missing Media
                            </a>
                            <a href="/settings/blacklist"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/blacklist")">
                                <i class="ti ti-shield-off me-2 opacity-75"></i>
                                Blacklist
                            </a>
                        </div>

                        <h4 class="subheader mt-4">System</h4>
                        <div class="list-group list-group-transparent">
                            <a href="/settings/maintenance"
                               class="list-group-item list-group-item-action d-flex align-items-center @ActiveCss("/settings/maintenance")">
                                <i class="ti ti-tool me-2 opacity-75"></i>
                                Maintenance
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-9 d-flex flex-column">
                    <div class="card-body flex-grow-1">
                        @Body
                    </div>

                    @if (_context.SaveAsync is not null)
                    {
                        <div class="card-footer bg-transparent border-top"
                             style="border-color: rgba(255,255,255,.08) !important;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    @if (!string.IsNullOrEmpty(_successMessage))
                                    {
                                        <span class="text-success small">
                                            <i class="bi bi-check-circle me-1"></i>@_successMessage
                                        </span>
                                    }
                                </div>
                                <div class="btn-list">
                                    @if (_context.HasChanges)
                                    {
                                        <button type="button" class="btn btn-app-ghost" @onclick="DiscardAsync">
                                            Discard
                                        </button>
                                    }
                                    <button type="button"
                                            class="btn @(_context.HasChanges ? "btn-app-primary" : "btn-app-ghost")"
                                            disabled="@(!_context.HasChanges)"
                                            @onclick="SaveAsync">
                                        @if (_saving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        Save Changes
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</CascadingValue>

@code {
    private readonly SettingsPageContext _context = new();
    private bool _saving;
    private string? _successMessage;
    private CancellationTokenSource? _messageCts;

    // Tooltips only need rebuilding when the page content changes, not on every render.
    private bool _tooltipsStale = true;

    protected override void OnInitialized()
    {
        _context.OnStateChanged += OnContextChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _tooltipsStale = true;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && !_tooltipsStale) return;
        _tooltipsStale = false;
        await Js.InvokeVoidAsync("refreshSettingsTooltips");
    }

    public void Dispose()
    {
        _context.OnStateChanged -= OnContextChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _messageCts?.Cancel();
        _messageCts?.Dispose();
    }

    private string ActiveCss(string href)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return path.Equals(href, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private async Task SaveAsync()
    {
        if (_context.SaveAsync is null) return;
        _saving = true;
        StateHasChanged();

        try
        {
            await _context.SaveAsync();
            _successMessage = "Settings saved";
            _context.HasChanges = false;
            _context.NotifyChanged();
            _ = ClearMessageAfterDelay();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DiscardAsync()
    {
        if (_context.DiscardAsync is not null)
            await _context.DiscardAsync();

        _context.HasChanges = false;
        _context.NotifyChanged();
    }

    private async Task ClearMessageAfterDelay()
    {
        _messageCts?.Cancel();
        _messageCts = new CancellationTokenSource();
        var token = _messageCts.Token;

        try
        {
            await Task.Delay(3000, token);
            _successMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

}
