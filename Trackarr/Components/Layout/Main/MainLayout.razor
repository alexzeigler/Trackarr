@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AppStateService AppState
@implements IDisposable

<div class="page">
    <AppSidebar/>
    <div class="page-wrapper">
        <AppTopbar/>
        <div class="page-body pt-3">
            <div class="container-xl">
                @* Catches unexpected errors in a page so they show here instead of ending the whole session. *@
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="alert alert-danger" role="alert">
                            <h4 class="alert-title">Something went wrong on this page</h4>
                            <div class="text-secondary mb-2">@ex.Message</div>
                            <button class="btn btn-app-primary btn-sm" @onclick="() => _errorBoundary?.Recover()">
                                Try again
                            </button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>
    </div>
</div>

<div id="blazor-error-ui" class="blazor-error-modal" data-nosnippet>
    <div class="blazor-error-card">
        <h3>An unhandled error has occurred</h3>
        <p>The application needs to reload to continue.</p>
        <a href="." class="reload btn btn-app-primary">Reload</a>
    </div>
</div>

@code {

    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        AppState.UpdateRoute(Nav.Uri);
        AppState.StartAutoRefresh();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        AppState.UpdateRoute(e.Location);

        // Leaving a broken page clears the error so the next page renders normally.
        _errorBoundary?.Recover();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

}
