@namespace Trackarr.Components.Tables
@typeparam TItem
@implements IAppTableState

<CascadingValue Value="@((IAppTableState)this)">
    <div class="card app-card">
        <div class="card-table">
            @if (ShowHeader)
            {
                <div class="card-header">
                    <div class="ms-auto d-flex flex-wrap btn-list">
                        @ToolbarTemplate

                        @if (ShowSearch)
                        {
                            <div class="input-group input-group-flat w-auto">
                                <span class="input-group-text">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="24"
                                         height="24"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="icon icon-1">
                                        <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                                        <path d="M21 21l-6 -6"></path>
                                    </svg>
                                </span>
                                <input type="text"
                                       class="form-control form-control-sm"
                                       autocomplete="off"
                                       placeholder="@SearchPlaceholder"
                                       value="@_searchTerm"
                                       @oninput="SetSearchTerm">
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="table-responsive">
                <table class="@TableClass">
                    <thead>
                    @HeaderTemplate
                    </thead>
                    <tbody class="table-tbody">
                    @if (FilteredCount == 0)
                    {
                        <tr>
                            <td colspan="@EmptyColspan" class="text-center text-muted py-4">@EmptyText</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in PagedItems)
                        {
                            @RowTemplate(item)
                        }
                    }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex align-items-center justify-content-end gap-4">
                <div class="fw-semibold">@PageStart - @PageEnd of @FilteredCount</div>
                <ul class="pagination mb-0 gap-2">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button type="button" class="page-link" disabled="@(_currentPage == 1)" @onclick="PreviousPage">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="icon icon-1"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M15 6l-6 6l6 6"></path>
                            </svg>
                        </button>
                    </li>
                    <li class="page-item @(_currentPage == TotalPages ? "disabled" : "")">
                        <button type="button"
                                class="page-link"
                                disabled="@(_currentPage == TotalPages)"
                                @onclick="NextPage">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="icon icon-1"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M9 6l6 6l-6 6"></path>
                            </svg>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter] public RenderFragment? ToolbarTemplate { get; set; }
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public IReadOnlyDictionary<string, Func<TItem, object?>> SortSelectors { get; set; } = new Dictionary<string, Func<TItem, object?>>();
    [Parameter] public Func<TItem, string, bool>? SearchPredicate { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int EmptyColspan { get; set; } = 1;
    [Parameter] public string EmptyText { get; set; } = "No records found";
    [Parameter] public string SearchPlaceholder { get; set; } = "";
    [Parameter] public string TableClass { get; set; } = "table table-vcenter table-selectable";
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string? DefaultSort { get; set; }
    [Parameter] public bool DefaultDescending { get; set; }

    private string _searchTerm = string.Empty;
    private string? _sortKey;
    private bool _sortDescending;
    private int _currentPage = 1;

    private List<TItem> FilteredItems => ApplyFilter().ToList();
    private List<TItem> SortedItems => ApplySort(FilteredItems).ToList();
    private List<TItem> PagedItems => SortedItems.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    private int FilteredCount => SortedItems.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));
    private int PageStart => FilteredCount == 0 ? 0 : (_currentPage - 1) * PageSize + 1;
    private int PageEnd => Math.Min(_currentPage * PageSize, FilteredCount);

    protected override void OnInitialized()
    {
        _sortKey = DefaultSort;
        _sortDescending = DefaultDescending;
    }

    protected override void OnParametersSet()
    {
        ClampPage();
    }

    public void SortBy(string key)
    {
        if (_sortKey == key)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortKey = key;
            _sortDescending = false;
        }

        _currentPage = 1;
        StateHasChanged();
    }

    public string SortMarker(string key)
    {
        if (_sortKey != key)
        {
            return string.Empty;
        }

        return _sortDescending ? "↓" : "↑";
    }

    private void SetSearchTerm(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
        StateHasChanged();
    }

    private IEnumerable<TItem> ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm) || SearchPredicate == null)
        {
            return Items;
        }

        return Items.Where(item => SearchPredicate(item, _searchTerm.Trim()));
    }

    private IEnumerable<TItem> ApplySort(IEnumerable<TItem> items)
    {
        if (_sortKey == null || !SortSelectors.TryGetValue(_sortKey, out var selector))
        {
            return items;
        }

        return _sortDescending
            ? items.OrderByDescending(selector, AppTableObjectComparer.Instance)
            : items.OrderBy(selector, AppTableObjectComparer.Instance);
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private void ClampPage()
    {
        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }
    }

    private sealed class AppTableObjectComparer : IComparer<object?>
    {
        public static readonly AppTableObjectComparer Instance = new();

        public int Compare(object? x, object? y)
        {
            if (x == null && y == null)
            {
                return 0;
            }

            if (x == null)
            {
                return -1;
            }

            if (y == null)
            {
                return 1;
            }

            if (x is IComparable comparableX && x.GetType() == y.GetType())
            {
                return comparableX.CompareTo(y);
            }

            return string.Compare(x.ToString(), y.ToString(), StringComparison.OrdinalIgnoreCase);
        }
    }

    public bool IsSorted(string key)
    {
        return _sortKey == key;
    }

    public bool IsDescending(string key)
    {
        return _sortKey == key && _sortDescending;
    }

    public string SortClass(string key)
    {
        return _sortKey == key ? "active text-primary" : "";
    }

}