@using Microsoft.AspNetCore.Http
@using Trackarr.Services.Settings
@inject IJSRuntime Js
@inject SettingsService SettingsService
@inject HostingOptions Hosting

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" class="m-0">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="@Hosting.BaseHref"/>
    <title>@SettingsService.GetString("General", "AppName", "Trackarr")</title>

    <ResourcePreloader/>
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <link rel="stylesheet" href="@("https://cdn.jsdelivr.net/npm/@tabler/core@1.4.0/dist/css/tabler.min.css")"/>
    <link rel="stylesheet"
          href="@("https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.50.0/dist/tabler-icons.min.css")"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Trackarr.styles.css"]"/>

    <ImportMap/>

    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png"/>
    <link rel="manifest" href="site.webmanifest"/>

    <HeadOutlet/>
</head>

<body>
<Routes @rendermode="PageRenderMode"/>
<ReconnectModal/>

<div id="tooltip-container"></div>
<script src="https://cdn.jsdelivr.net/npm/apexcharts@8.7.0/dist/apexcharts.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
<script src="@("https://cdn.jsdelivr.net/npm/@tabler/core@1.4.0/dist/js/tabler.min.js")"></script>
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
<script src="js/bootstrapHelper.js"></script>
<script src="js/historyChart.js"></script>
<script src="js/queueChart.js"></script>
<script src="js/missingChart.js"></script>
<script src="js/uptimeChart.js"></script>

<script>

</script>

<script src="@Assets["_framework/blazor.web.js"]"></script>

</body>
</html>

@code {

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // The login and setup pages render statically, because a sign-in cookie can only be set on a normal HTTP
    // response, not from an interactive circuit. Every other page is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(false) : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("initTooltips");
        }
    }

}
