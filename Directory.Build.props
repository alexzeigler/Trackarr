<Project>
  <!-- Settings every project shares. Package versions live in Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The recommended .NET analyzer rules. Rules that don't fit this project are turned down in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Release builds (CI and Docker) fail on any warning, so warnings can't pile up. Debug builds only show them. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Culture-sensitive string handling (CA1304/1305/1310/1311) is an error too since AUDIT B3 was fixed. -->
    <!-- A new security advisory for a package shouldn't block a release the day it's published. It still shows. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
